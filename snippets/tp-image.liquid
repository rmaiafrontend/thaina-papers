{%- doc -%}
  Renderiza uma imagem com três níveis de fallback, na ordem:
  1. imagem escolhida no editor (image_picker, vem dos Arquivos da loja);
  2. imagem embutida no tema (assets/), útil enquanto a loja não tem
     upload próprio — é o que evita a página nascer só com placeholder;
  3. placeholder com legenda.

  @param {image} [image] - valor de um setting image_picker
  @param {string} [asset] - nome do arquivo em assets/ (ex.: 'tp-foo.jpg')
  @param {string} [alt] - texto alternativo / legenda do placeholder
  @param {string} [class] - classes extras no wrapper
  @param {string} [sizes] - atributo sizes
  @param {string} [widths] - larguras para o srcset
  @param {number} [width] - largura base para image_url
  @param {string} [loading] - lazy (padrão) ou eager
  @param {string} [ratio] - proporção do arquivo em assets/, ex.: '3/4'. Só afeta
    o width/height que o navegador usa para reservar a caixa antes de carregar.

  @example
  {% render 'tp-image', image: section.settings.image_1, asset: section.settings.image_1_asset, alt: 'Convite', class: 'tp-hero__frame', width: 1200 %}
{%- enddoc -%}

{%- liquid
  assign img_width = width | default: 900
  assign img_sizes = sizes | default: '100vw'
  assign img_widths = widths | default: '400,700,1000,1400'
  assign img_loading = loading | default: 'lazy'
-%}

<div class="tp-media {{ class }}">
  {%- if image != blank -%}
    {{
      image
      | image_url: width: img_width
      | image_tag: loading: img_loading, sizes: img_sizes, widths: img_widths, alt: alt
    }}
  {%- elsif asset != blank -%}
    {%- liquid
      # A imagem do tema também merece srcset: sem ele o celular baixava o
      # arquivo inteiro para um espaço de um terço da tela. Montado com append
      # em vez de capture, senão a quebra de linha do arquivo entra na string.
      assign asset_srcset = ''
      assign larguras = img_widths | split: ','
      for l in larguras
        assign larg = l | strip
        assign medida = larg | append: 'x'
        assign url = asset | asset_img_url: medida
        assign par = url | append: ' ' | append: larg | append: 'w'
        if asset_srcset == blank
          assign asset_srcset = par
        else
          assign asset_srcset = asset_srcset | append: ', ' | append: par
        endif
      endfor
    -%}
    {%- liquid
      # width/height existem para o navegador reservar a caixa certa antes de
      # carregar. O valor de antes era 1400x1400 — quadrado, e nenhuma foto do
      # site é quadrada, então a reserva saía na proporção errada. Agora quem
      # chama declara a proporção do arquivo; sem ela, cai no quadrado de novo.
      assign nat_w = 1000
      assign nat_h = 1000
      if ratio != blank
        assign lados = ratio | split: '/'
        assign lado_w = lados[0] | plus: 0
        assign lado_h = lados[1] | plus: 0
        if lado_w > 0 and lado_h > 0
          assign nat_h = nat_w | times: lado_h | divided_by: lado_w
        endif
      endif
    -%}
    <img
      src="{{ asset | asset_url }}"
      srcset="{{ asset_srcset }}"
      sizes="{{ img_sizes }}"
      alt="{{ alt | escape }}"
      loading="{{ img_loading }}"
      width="{{ nat_w }}"
      height="{{ nat_h }}"
    >
  {%- else -%}
    <div class="tp-media__placeholder">{{ alt }}</div>
  {%- endif -%}
</div>
