{%- doc -%}
  Card de produto da landing: foto (ou inicial sobre vinho, sem foto), nome,
  preço e botão que abre o WhatsApp com o nome do produto escrito.

  @param {object} produto - O produto.
  @param {string} [contexto] - Vai entre parênteses na mensagem (ex.: "Casamentos").
  @param {number} [i] - Índice para o atraso da animação de entrada.
  @param {string} [sizes] - Atributo sizes da imagem.
{%- enddoc -%}
{%- liquid
  assign tam = sizes | default: '(max-width: 899px) 45vw, 270px'
  if contexto != blank
    capture msg
      echo 'Olá, Thainá! Vi no site e quero saber mais sobre: ' | append: produto.title | append: ' (' | append: contexto | append: ').'
    endcapture
  else
    capture msg
      echo 'Olá, Thainá! Vi no site e quero saber mais sobre: ' | append: produto.title | append: '.'
    endcapture
  endif
-%}
<li class="lp-card" style="--i: {{ i | default: 0 }}" data-lp-reveal="up">
  <div class="lp-card__midia{% if produto.featured_image == blank %} lp-card__midia--tipo{% endif %}">
    {%- if produto.featured_image != blank -%}
      {{ produto.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: tam, alt: produto.title, class: 'lp-card__foto' }}
    {%- else -%}
      <span class="lp-card__inicial" aria-hidden="true">{{ produto.title | slice: 0 }}</span>
    {%- endif -%}
  </div>
  <div class="lp-card__corpo">
    <h4 class="lp-card__nome">{{ produto.title }}</h4>
    <p class="lp-card__preco">
      {%- if produto.price_varies -%}a partir de {% endif -%}
      {{ produto.price_min | money }}
    </p>
    <a class="lp-card__pedir" href="{% render 'tp-lp-wa', message: msg %}" target="_blank" rel="noopener" aria-label="Pedir {{ produto.title | escape }} no WhatsApp">
      {%- render 'tp-lp-icone-wa' -%} Pedir
    </a>
  </div>
</li>
