{%- comment -%}
  Layout da landing (/?view=landing): sem cabeçalho, rodapé, sacola nem
  scripts da loja. A página é um catálogo que termina no WhatsApp, então
  tudo que existe para o checkout só pesaria no carregamento do celular.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#a9c6dc">
    <title>{{ shop.name }} — papelaria feita à mão</title>
    <meta name="description" content="Convites, papelaria de casamento, formaturas e consultórios feitos à mão em João Pessoa. Escolha no catálogo e peça pelo WhatsApp.">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'tp-favicon.svg' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'tp-favicon-180.png' | asset_url }}">
    {%- endif -%}

    {%- comment -%}
      Playfair Display vem do Google Fonts: é a única fonte da landing que o
      tema não hospeda, e precisa do itálico de verdade, que a Fraunces do
      tema não tem.
    {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap">
    {{ 'tp-allura-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    <script>document.documentElement.classList.add('lp-js');</script>
    {{ 'tp-landing.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'tp-landing.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="lp">
    <a class="lp-skip" href="#lp-catalogo">Pular para o catálogo</a>
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
