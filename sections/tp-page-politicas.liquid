{%- liquid
  # O link de ajuda é contato: sem destino próprio cai no WhatsApp global.
  assign _whats = settings.tp_whatsapp_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '+'
  assign _whats_url = ''
  if _whats != blank
    assign _whats_url = 'https://wa.me/' | append: _whats
  endif
-%}

{%- liquid
  assign policy_links = section.blocks | where: 'type', 'policy_link'
  assign clauses = section.blocks | where: 'type', 'clause'

  # Uma política começa aberta: prioriza a marcação do lojista e, se ninguém
  # marcar, abre a primeira do índice.
  assign current_index = -1
  for block in policy_links
    if current_index == -1 and block.settings.is_current
      assign current_index = forloop.index0
    endif
  endfor
  if current_index == -1
    assign current_index = 0
  endif
-%}

{%- comment -%}
  As chaves viram o id de cada painel e o hash da URL. Vivem numa string
  separada por vírgula porque o Liquid não monta array dentro de um for.
{%- endcomment -%}
{%- capture keys_csv -%}
  {%- for block in policy_links -%}
    {%- if block.settings.key != blank -%}{{ block.settings.key | handle }}{%- else -%}politica-{{ forloop.index }}{%- endif -%}
    {%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign keys = keys_csv | strip | split: ',' -%}
{%- assign default_key = keys[current_index] -%}

<div class="tp-politicas" data-tp-politicas>
  <div class="tp-politicas__inner">
    <aside class="tp-politicas__aside">
      {%- if policy_links.size > 0 -%}
        <div class="tp-politicas__aside-label">{{ section.settings.index_label }}</div>
        <nav class="tp-politicas__index">
          {%- for block in policy_links -%}
            {%- assign k = keys[forloop.index0] -%}
            {%- assign is_current = false -%}
            {%- if forloop.index0 == current_index -%}
              {%- assign is_current = true -%}
            {%- endif -%}
            <a
              href="#tp-pol-{{ k }}"
              class="tp-politicas__index-link{% if is_current %} tp-politicas__index-link--current{% endif %}"
              data-tp-politica-tab="{{ k }}"
              {% if is_current %}aria-current="true"{% endif %}
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label -}}
            </a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      {%- if section.settings.help_title != blank -%}
        <div class="tp-politicas__help">
          <div class="tp-politicas__help-title">{{ section.settings.help_title }}</div>
          {%- if section.settings.help_text != blank -%}
            <div class="tp-politicas__help-text">{{ section.settings.help_text }}</div>
          {%- endif -%}
          {%- if section.settings.help_link_label != blank -%}
            <a {% assign _ajuda = section.settings.help_link | default: _whats_url %}{% if _ajuda != blank %}href="{{ _ajuda }}"{% endif %} class="tp-politicas__help-link">
              {{- section.settings.help_link_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </aside>

    <div class="tp-politicas__content" data-tp-politicas-content>
      {%- for block in policy_links -%}
        {%- assign k = keys[forloop.index0] -%}
        {%- assign is_current = false -%}
        {%- if forloop.index0 == current_index -%}
          {%- assign is_current = true -%}
        {%- endif -%}

        {%- comment -%} Quantas cláusulas pertencem a esta política. {%- endcomment -%}
        {%- assign group_size = 0 -%}
        {%- for c in clauses -%}
          {%- assign cp = c.settings.policy | handle | default: default_key -%}
          {%- if cp == k -%}
            {%- assign group_size = group_size | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        <article
          id="tp-pol-{{ k }}"
          class="tp-politicas__panel{% if is_current %} is-active{% endif %}"
          data-tp-politica-panel="{{ k }}"
          {{ block.shopify_attributes }}
        >
          <div class="tp-politicas__breadcrumb">
            <a href="{{ routes.root_url }}">Início</a>
            <span aria-hidden="true"> / </span>
            <span>{{ section.settings.index_label }} / {{ block.settings.label }}</span>
          </div>

          <h1 class="tp-politicas__title">{{ block.settings.title | default: block.settings.label }}</h1>
          {%- assign updated = block.settings.updated_at -%}
          {%- if updated == blank and group_size > 0 -%}
            {%- assign updated = section.settings.updated_at -%}
          {%- endif -%}
          {%- if updated != blank -%}
            <div class="tp-politicas__updated">{{ updated }}</div>
          {%- endif -%}

          {%- if group_size > 0 -%}
            <div class="tp-politicas__clauses">
              {%- for c in clauses -%}
                {%- assign cp = c.settings.policy | handle | default: default_key -%}
                {%- if cp == k -%}
                  <div class="tp-politicas__clause" {{ c.shopify_attributes }}>
                    <div class="tp-politicas__clause-title">{{ c.settings.title }}</div>

                    {%- if c.settings.body != blank -%}
                      <div class="tp-politicas__clause-body">{{ c.settings.body }}</div>
                    {%- endif -%}

                    {%- assign rows = c.settings.rows | newline_to_br | split: '<br />' -%}
                    {%- assign has_rows = false -%}
                    {%- for raw_row in rows -%}
                      {%- if raw_row != blank -%}
                        {%- assign has_rows = true -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if has_rows -%}
                      <div class="tp-politicas__rows">
                        {%- for raw_row in rows -%}
                          {%- assign row = raw_row | strip -%}
                          {%- if row != blank -%}
                            {%- assign label = row | split: '|' | first | strip -%}
                            {%- assign value = row | split: '|' | last | strip -%}
                            <div class="tp-politicas__row"><span>{{ label }}</span><span>{{ value }}</span></div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- elsif block.settings.empty_text != blank -%}
            <div class="tp-politicas__vazio">{{ block.settings.empty_text }}</div>
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="tp-btn tp-btn--outline tp-politicas__panel-link">
              {{- block.settings.link_label | default: 'Ler o documento completo →' -}}
            </a>
          {%- endif -%}

          {%- if block.settings.note != blank -%}
            <div class="tp-politicas__note">{{ block.settings.note }}</div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.announcement_override != blank -%}
  <script>
    (function () {
      var text = {{ section.settings.announcement_override | json }};
      var desktop = document.querySelector('.tp-header__announce--desktop');
      var mobile = document.querySelector('.tp-header__announce--mobile');
      if (desktop) desktop.textContent = text;
      if (mobile) mobile.textContent = text;
    })();
  </script>
{%- endif -%}

<script src="{{ 'tp-politicas.js' | asset_url }}" defer></script>

{% stylesheet %}
  .tp-politicas {
    font-family: var(--tp-sans);
    color: var(--tp-ink);
    background: var(--tp-cream);
  }

  .tp-politicas * {
    box-sizing: border-box;
  }

  .tp-politicas a {
    color: inherit;
    text-decoration: none;
  }

  .tp-politicas__inner {
    display: flex;
    gap: 56px;
    align-items: flex-start;
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding-block: 56px 72px;
    padding-inline: var(--tp-gutter);
  }

  .tp-politicas__aside {
    width: 300px;
    flex: none;
  }

  .tp-politicas__aside-label {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-muted);
    margin-bottom: 18px;
  }

  .tp-politicas__index {
    display: grid;
    font-size: 15px;
  }

  .tp-politicas__index-link {
    padding-block: 12px;
    border-top: 1px solid rgba(61, 39, 34, 0.14);
  }

  .tp-politicas__index-link:last-child {
    border-bottom: 1px solid rgba(61, 39, 34, 0.14);
  }

  .tp-politicas__index-link:hover {
    color: var(--tp-wine);
  }

  /* Escopadas sob .tp-politicas para vencer ".tp-politicas a { color: inherit }",
     que tem especificidade maior que uma classe sozinha. */
  .tp-politicas .tp-politicas__index-link--current {
    color: var(--tp-wine);
    font-weight: 500;
  }

  .tp-politicas__help {
    margin-top: 26px;
    border: 1px solid var(--tp-line);
    padding: 20px 18px;
  }

  .tp-politicas__help-title {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 6px;
  }

  .tp-politicas__help-text {
    font-size: 13px;
    line-height: 1.6;
    color: var(--tp-muted);
    margin-bottom: 12px;
  }

  .tp-politicas__help-text p {
    margin: 0;
  }

  .tp-politicas .tp-politicas__help-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--tp-wine);
  }

  .tp-politicas__content {
    flex: 1;
    min-width: 0;
    max-width: 760px;
  }

  .tp-politicas__breadcrumb {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-muted);
    margin-bottom: 14px;
  }

  .tp-politicas__breadcrumb a:hover {
    color: var(--tp-wine);
  }

  .tp-politicas__title {
    font-family: var(--tp-serif);
    font-weight: 400;
    font-size: 42px;
    line-height: 1.16;
    margin: 0 0 12px;
  }

  .tp-politicas__updated {
    font-size: 13px;
    color: var(--tp-muted);
    margin-bottom: 36px;
  }

  .tp-politicas__clause {
    border-top: 1px solid var(--tp-line);
    padding-block: 24px;
  }

  .tp-politicas__clauses .tp-politicas__clause:last-child {
    border-bottom: 1px solid var(--tp-line);
  }

  .tp-politicas__clause-title {
    font-family: var(--tp-serif);
    font-size: 22px;
    font-weight: 500;
    margin-bottom: 10px;
  }

  .tp-politicas__clause-body {
    font-size: 15px;
    line-height: 1.75;
    color: var(--tp-body);
  }

  .tp-politicas__clause-body p {
    margin: 0;
  }

  .tp-politicas__clause-body p + p {
    margin-top: 10px;
  }

  .tp-politicas__rows {
    display: grid;
    gap: 10px;
    font-size: 15px;
    max-width: 460px;
    margin-top: 14px;
  }

  .tp-politicas__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid rgba(61, 39, 34, 0.12);
    padding-bottom: 8px;
  }

  .tp-politicas__row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .tp-politicas__row span:last-child {
    color: var(--tp-muted);
    text-align: right;
  }

  .tp-politicas__note {
    margin-top: 26px;
    padding: 20px 22px;
    background: var(--tp-stone);
    font-size: 14px;
    line-height: 1.7;
    color: var(--tp-body);
  }

  .tp-politicas__note p {
    margin: 0;
  }

  .tp-politicas__note a {
    color: var(--tp-wine);
    font-weight: 500;
  }

  @media (max-width: 1100px) {
    .tp-politicas__inner {
      gap: 32px;
    }

    .tp-politicas__aside {
      width: 240px;
    }
  }

  @media (max-width: 899px) {
    .tp-politicas__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
      padding-block: 28px 40px;
    }

    .tp-politicas__aside {
      width: auto;
      order: 2;
    }

    .tp-politicas__content {
      order: 1;
      max-width: none;
    }

    .tp-politicas__title {
      font-size: 30px;
    }

    .tp-politicas__updated {
      margin-bottom: 24px;
    }

    .tp-politicas__clause-title {
      font-size: 20px;
    }

    .tp-politicas__rows {
      max-width: none;
    }

    .tp-politicas__row {
      flex-direction: column;
      gap: 2px;
    }

    .tp-politicas__row span:last-child {
      text-align: left;
    }
  }
  /* Uma política por vez. Sem JS todas ficam empilhadas — nada some do ar e
     o rastreador continua vendo o texto inteiro; assim que o script assume,
     ele marca .tp-js e passa a mostrar só a selecionada. */
  .tp-politicas.tp-js .tp-politicas__panel {
    display: none;
  }

  .tp-politicas.tp-js .tp-politicas__panel.is-active {
    display: block;
  }

  .tp-politicas__panel + .tp-politicas__panel {
    margin-top: 48px;
  }

  .tp-politicas.tp-js .tp-politicas__panel + .tp-politicas__panel {
    margin-top: 0;
  }

  .tp-politicas__vazio {
    border-top: 1px solid var(--tp-line);
    border-bottom: 1px solid var(--tp-line);
    padding-block: 24px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--tp-body);
  }

  .tp-politicas .tp-politicas__panel-link {
    display: inline-flex;
    margin-top: 24px;
    height: 46px;
    font-size: 14px;
    border-color: var(--tp-line-strong);
    color: var(--tp-ink);
  }

  .tp-politicas .tp-politicas__panel-link:hover {
    border-color: var(--tp-wine);
    color: var(--tp-wine);
  }

{% endstylesheet %}

{% schema %}
{
  "name": "TP — Políticas",
  "settings": [
    {
      "type": "text",
      "id": "announcement_override",
      "label": "Aviso do topo (só nesta página)",
      "default": "Regras válidas para pedidos feitos a partir de 1º de setembro de 2026"
    },
    {
      "type": "text",
      "id": "index_label",
      "label": "Título do índice lateral",
      "default": "Políticas"
    },
    {
      "type": "header",
      "content": "Conteúdo",
      "info": "Cada item do índice é uma política, e o clique troca só o painel da direita — não muda de página. As cláusulas são ligadas a uma política pela chave."
    },
    {
      "type": "text",
      "id": "updated_at",
      "label": "Data de atualização (padrão de todas)",
      "default": "Atualizada em 26 de agosto de 2026"
    },
    {
      "type": "header",
      "content": "Caixa de ajuda"
    },
    {
      "type": "text",
      "id": "help_title",
      "label": "Título",
      "default": "Ficou alguma dúvida?"
    },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Texto",
      "default": "<p>A Thainá responde pelo WhatsApp em até 2 dias úteis.</p>"
    },
    {
      "type": "text",
      "id": "help_link_label",
      "label": "Link",
      "default": "Falar no WhatsApp →"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Destino do link"
    }
  ],
  "blocks": [
    {
      "type": "policy_link",
      "name": "Item do índice",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto do índice",
          "default": "Catálogo"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Chave",
          "info": "Só letras minúsculas e hífen (ex.: produtos-fisicos). Liga as cláusulas a esta política e vira o endereço #tp-pol-chave."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título do painel",
          "info": "Se ficar vazio, repete o texto do índice."
        },
        {
          "type": "text",
          "id": "updated_at",
          "label": "Data de atualização",
          "info": "Vazio herda a data padrão da seção — mas só nas políticas que já têm cláusulas escritas."
        },
        {
          "type": "richtext",
          "id": "empty_text",
          "label": "Texto quando ainda não há cláusulas"
        },
        {
          "type": "richtext",
          "id": "note",
          "label": "Nota final (caixa destacada)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Documento completo (botão no fim do painel)"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texto do botão",
          "default": "Ler o documento completo →"
        },
        {
          "type": "checkbox",
          "id": "is_current",
          "label": "Começa aberta",
          "default": false
        }
      ]
    },
    {
      "type": "clause",
      "name": "Cláusula",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "1. Aprovação antes da produção"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Texto"
        },
        {
          "type": "textarea",
          "id": "rows",
          "label": "Lista rótulo/valor (uma por linha: Rótulo | Valor)"
        },
        {
          "type": "text",
          "id": "policy",
          "label": "Chave da política",
          "info": "A mesma chave do item do índice. Vazio cai na política que começa aberta."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP — Políticas",
      "blocks": [
        { "type": "policy_link" },
        { "type": "policy_link" },
        { "type": "clause" },
        { "type": "clause" }
      ]
    }
  ]
}
{% endschema %}
