{%- liquid
  assign img_1 = section.settings.image_1
  assign img_2 = section.settings.image_2
-%}

<section class="tp-section tp-hero">
  <div class="tp-hero__inner">
    <div class="tp-hero__copy">
      {%- if section.settings.script_text != blank -%}
        <div class="tp-script">{{ section.settings.script_text }}</div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="tp-display tp-hero__title">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.lead != blank -%}
        <p class="tp-hero__lead">{{ section.settings.lead }}</p>
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p class="tp-hero__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="tp-hero__description">{{ section.settings.description }}</p>
      {%- endif -%}

      <div class="tp-hero__actions">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link | default: '#' }}" class="tp-btn tp-btn--solid">
            {{- section.settings.button_1_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link | default: '#' }}" class="tp-btn tp-btn--outline">
            {{- section.settings.button_2_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="tp-hero__media">
      <div class="tp-media tp-hero__media-item">
        {%- if img_1 != blank -%}
          {{ img_1 | image_url: width: 900 | image_tag: loading: 'eager', sizes: '(max-width: 749px) 45vw, 30vw', widths: '400,600,900' }}
        {%- else -%}
          <div class="tp-media__placeholder">{{ section.settings.image_1_alt | default: 'Imagem 1' }}</div>
        {%- endif -%}
      </div>
      <div class="tp-media tp-hero__media-item tp-hero__media-item--offset">
        {%- if img_2 != blank -%}
          {{ img_2 | image_url: width: 900 | image_tag: loading: 'eager', sizes: '(max-width: 749px) 45vw, 30vw', widths: '400,600,900' }}
        {%- else -%}
          <div class="tp-media__placeholder">{{ section.settings.image_2_alt | default: 'Imagem 2' }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .tp-hero {
    padding-block: 92px 84px;
  }

  .tp-hero__inner {
    display: flex;
    align-items: center;
    gap: 80px;
  }

  .tp-hero__copy {
    width: 480px;
    flex: none;
  }

  .tp-hero__title {
    font-size: 46px;
    margin-bottom: 20px;
  }

  .tp-hero__lead {
    font-family: var(--tp-serif);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--tp-ink);
    margin: 0 0 18px;
    max-width: 420px;
  }

  .tp-hero__tagline {
    font-size: 15px;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--tp-body);
    margin: 0 0 14px;
  }

  .tp-hero__description {
    font-size: 16px;
    line-height: 1.6;
    color: var(--tp-body);
    margin: 0 0 30px;
    max-width: 400px;
  }

  .tp-hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tp-hero__media {
    flex: 1;
    min-width: 0;
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .tp-hero__media-item {
    flex: 1;
    min-width: 0;
    height: 420px;
  }

  .tp-hero__media-item--offset {
    margin-top: 56px;
  }

  @media (max-width: 1100px) {
    .tp-hero__inner {
      gap: 40px;
    }

    .tp-hero__copy {
      width: 400px;
    }

    .tp-hero__title {
      font-size: 38px;
    }

    .tp-hero__media-item {
      height: 340px;
    }
  }

  @media (max-width: 899px) {
    .tp-hero {
      padding-block: 36px 36px;
    }

    .tp-hero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
    }

    .tp-hero__copy {
      width: auto;
    }

    .tp-hero__title {
      font-size: 32px;
      line-height: 1.16;
      margin-bottom: 14px;
    }

    .tp-hero__lead {
      font-size: 19px;
      margin-bottom: 14px;
    }

    .tp-hero__tagline {
      font-size: 14px;
      margin-bottom: 12px;
    }

    .tp-hero__description {
      margin-bottom: 22px;
    }

    .tp-hero__media {
      gap: 10px;
    }

    .tp-hero__media-item {
      height: 230px;
    }

    .tp-hero__media-item--offset {
      margin-top: 28px;
    }
  }

  @media (max-width: 749px) {
    .tp-hero__actions .tp-btn {
      height: 48px;
      padding: 0 16px;
      flex: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "script_text",
      "label": "Texto manuscrito",
      "default": "feito à mão"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Não é só papel."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Frase de destaque",
      "default": "É a primeira parte da história que chega às mãos de quem você escolheu para vivê-la com você."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Assinatura",
      "default": "Menos excesso. Mais essência."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrição",
      "default": "Tailor-made stationery for celebrations. Impressos em pequenos lotes e templates editáveis no Canva."
    },
    {
      "type": "header",
      "content": "Botões"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Botão principal",
      "default": "Ver todos os produtos"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link do botão principal"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Botão secundário",
      "default": "Sob medida"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link do botão secundário"
    },
    {
      "type": "header",
      "content": "Imagens"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Imagem 1"
    },
    {
      "type": "text",
      "id": "image_1_alt",
      "label": "Legenda do espaço 1",
      "default": "Suíte de convites sobre linho"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Imagem 2 (deslocada)"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Legenda do espaço 2",
      "default": "Menu ao lado do prato"
    }
  ],
  "presets": [
    {
      "name": "TP — Hero"
    }
  ]
}
{% endschema %}
