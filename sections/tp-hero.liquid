{%- liquid
  assign img_1 = section.settings.image_1
  assign img_2 = section.settings.image_2
-%}

<section class="tp-section tp-hero">
  <div class="tp-hero__inner">
    {%- if section.settings.script_text != blank -%}
      <div class="tp-hero__script">{{ section.settings.script_text }}</div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="tp-hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    <figure class="tp-hero__figure tp-hero__figure--main">
      {%- render 'tp-image',
        image: img_1,
        asset: section.settings.image_1_asset,
        alt: section.settings.image_1_alt,
        class: 'tp-hero__frame',
        width: 1200,
        sizes: '(max-width: 899px) 100vw, 42vw',
        widths: '500,800,1200',
        loading: 'eager'
      -%}
    </figure>

    <div class="tp-hero__body">
      {%- if section.settings.lead != blank -%}
        <p class="tp-hero__lead">{{ section.settings.lead }}</p>
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <div class="tp-hero__rule">
          <span class="tp-hero__rule-line" aria-hidden="true"></span>
          <span class="tp-hero__tagline">{{ section.settings.tagline }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="tp-hero__description">{{ section.settings.description }}</p>
      {%- endif -%}

      <div class="tp-hero__actions">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link | default: '#' }}" class="tp-btn tp-btn--solid">
            {{- section.settings.button_1_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link | default: '#' }}" class="tp-btn tp-btn--outline">
            {{- section.settings.button_2_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <figure class="tp-hero__figure tp-hero__figure--sub">
      {%- render 'tp-image',
        image: img_2,
        asset: section.settings.image_2_asset,
        alt: section.settings.image_2_alt,
        class: 'tp-hero__frame',
        width: 700,
        sizes: '(max-width: 899px) 50vw, 20vw',
        widths: '300,500,700',
        loading: 'eager'
      -%}
    </figure>
  </div>
</section>

{% stylesheet %}
  .tp-hero {
    padding-block: 72px 88px;
    overflow: hidden;
  }

  /* Composição editorial: o título é o protagonista e a imagem principal
     invade a coluna dele, criando a assimetria. O grid de 12 colunas
     permite posicionar cada peça em vez de empilhar em flex. */
  .tp-hero__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: start;
  }

  .tp-hero__script {
    grid-column: 1 / 7;
    grid-row: 1;
    font-family: var(--tp-script);
    font-size: 34px;
    line-height: 1;
    color: var(--tp-rose);
    margin-bottom: 10px;
  }

  .tp-hero__title {
    grid-column: 1 / 8;
    grid-row: 2;
    position: relative;
    z-index: 3;
    font-family: var(--tp-serif);
    /* A Fraunces é variável de 100 a 900: aqui o peso baixo é real,
       não uma aproximação do navegador. */
    font-weight: 300;
    font-size: clamp(46px, 7.4vw, 116px);
    line-height: 0.94;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .tp-hero__figure {
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .tp-hero__frame {
    height: 100%;
  }

  /* Sobe uma linha e atravessa o título: é o que quebra o grid. */
  .tp-hero__figure--main {
    grid-column: 7 / 13;
    grid-row: 1 / 4;
    height: 520px;
    margin-top: 8px;
  }

  /* Encavala o canto da imagem principal: é a camada que dá profundidade. */
  .tp-hero__figure--sub {
    grid-column: 5 / 8;
    grid-row: 3;
    z-index: 2;
    height: 220px;
    margin-top: 96px;
    margin-inline-end: -24px;
    box-shadow: 0 0 0 10px var(--tp-cream);
  }

  .tp-hero__body {
    grid-column: 1 / 5;
    grid-row: 3;
    padding-top: 44px;
  }

  .tp-hero__lead {
    font-family: var(--tp-serif);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--tp-ink);
    margin: 0 0 22px;
  }

  .tp-hero__rule {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .tp-hero__rule-line {
    width: 46px;
    height: 1px;
    flex: none;
    background: var(--tp-line-strong);
  }

  .tp-hero__tagline {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tp-muted);
  }

  .tp-hero__description {
    font-size: 15px;
    line-height: 1.65;
    color: var(--tp-body);
    margin: 0 0 30px;
  }

  .tp-hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 1100px) {
    .tp-hero {
      padding-block: 56px 64px;
    }

    .tp-hero__figure--main {
      height: 400px;
    }

    .tp-hero__figure--sub {
      height: 170px;
      margin-top: 72px;
    }

    .tp-hero__body {
      padding-top: 28px;
    }
  }

  /* No estreito a assimetria não é abandonada, é reescrita: a imagem
     principal sangra até as bordas da tela e a secundária continua
     encavalada no canto dela, saindo pela direita. Empilhar tudo centrado
     jogaria fora justamente o que define esta hero. */
  @media (max-width: 899px) {
    .tp-hero {
      padding-block: 32px 44px;
    }

    .tp-hero__inner {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: 0;
    }

    .tp-hero__script {
      grid-column: 1 / -1;
      grid-row: 1;
      font-size: 28px;
    }

    .tp-hero__title {
      grid-column: 1 / -1;
      grid-row: 2;
      font-size: clamp(42px, 12.4vw, 64px);
      line-height: 0.98;
    }

    .tp-hero__figure--main {
      grid-column: 1 / -1;
      grid-row: 3;
      height: 340px;
      margin-top: 26px;
      /* Sangra o gutter: a foto encosta nas bordas da tela. */
      margin-inline: calc(var(--tp-gutter) * -1);
    }

    /* Mesma sobreposição do desktop, ancorada no rodapé da foto principal. */
    .tp-hero__figure--sub {
      grid-column: 4 / 7;
      grid-row: 3;
      align-self: end;
      z-index: 2;
      height: 128px;
      margin-bottom: -46px;
      margin-inline-end: calc(var(--tp-gutter) * -1);
      box-shadow: 0 0 0 8px var(--tp-cream);
    }

    .tp-hero__body {
      grid-column: 1 / -1;
      grid-row: 4;
      /* Espaço para a secundária, que desce 46px sobre esta área. */
      padding-top: 74px;
    }

    .tp-hero__lead {
      font-size: 19px;
      margin-bottom: 18px;
    }

    .tp-hero__description {
      margin-bottom: 22px;
    }
  }

  @media (max-width: 749px) {
    .tp-hero__figure--main {
      height: 300px;
    }

    .tp-hero__figure--sub {
      grid-column: 3 / 7;
      height: 112px;
      margin-bottom: -40px;
    }

    .tp-hero__body {
      padding-top: 66px;
    }

    /* Lado a lado, "Ver todos os produtos" quebra em duas linhas e o texto
       é cortado pela altura fixa do botão. Empilhados, cabem. */
    .tp-hero__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .tp-hero__actions .tp-btn {
      height: 50px;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "script_text",
      "label": "Texto manuscrito",
      "default": "feito à mão"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Não é só papel."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Frase de destaque",
      "default": "É a primeira parte da história que chega às mãos de quem você escolheu para vivê-la com você."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Assinatura",
      "default": "Menos excesso. Mais essência."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrição",
      "default": "Tailor-made stationery for celebrations. Impressos em pequenos lotes e templates editáveis no Canva."
    },
    {
      "type": "header",
      "content": "Botões"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Botão principal",
      "default": "Ver todos os produtos"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link do botão principal"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Botão secundário",
      "default": "Sob medida"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link do botão secundário"
    },
    {
      "type": "header",
      "content": "Imagens"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Imagem principal"
    },
    {
      "type": "text",
      "id": "image_1_asset",
      "label": "Arquivo no tema (fallback)",
      "info": "Usado só quando nenhuma imagem é escolhida acima."
    },
    {
      "type": "text",
      "id": "image_1_alt",
      "label": "Legenda do espaço principal",
      "default": "Suíte de convites sobre linho"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Imagem de apoio"
    },
    {
      "type": "text",
      "id": "image_2_asset",
      "label": "Arquivo no tema (fallback)",
      "info": "Usado só quando nenhuma imagem é escolhida acima."
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Legenda do espaço de apoio",
      "default": "Menu ao lado do prato"
    }
  ],
  "presets": [
    {
      "name": "TP — Hero"
    }
  ]
}
{% endschema %}
