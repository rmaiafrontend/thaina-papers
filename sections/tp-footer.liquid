{%- liquid
  assign columns = section.blocks | where: 'type', 'link_column'
  assign socials = section.blocks | where: 'type', 'social_link'
-%}

<footer class="tp-footer">
  <div class="tp-footer__top">
    <div class="tp-footer__brand">
      <div class="tp-footer__wordmark">{{ section.settings.wordmark | default: 'THAINÁ PAPERS' }}</div>
      {%- if section.settings.description != blank -%}
        <p class="tp-footer__description">{{ section.settings.description }}</p>
      {%- endif -%}
      {%- if section.settings.whatsapp_label != blank -%}
        <a href="{{ section.settings.whatsapp_link | default: '#' }}" class="tp-btn tp-btn--solid tp-footer__whatsapp">
          {{- section.settings.whatsapp_label -}}
        </a>
      {%- endif -%}
      {%- if section.settings.hours != blank or section.settings.email != blank -%}
        <div class="tp-footer__contact">
          {{- section.settings.hours -}}
          {%- if section.settings.hours != blank and section.settings.email != blank -%}<br>{%- endif -%}
          {{- section.settings.email -}}
        </div>
      {%- endif -%}
    </div>

    <div class="tp-footer__columns">
      {%- for block in columns -%}
        <div class="tp-footer__column" {{ block.shopify_attributes }}>
          <div class="tp-footer__column-title">{{ block.settings.title }}</div>
          <div class="tp-footer__column-links">
            {%- assign links = block.settings.links | newline_to_br | split: '<br />' -%}
            {%- for raw_line in links -%}
              {%- assign line = raw_line | strip -%}
              {%- if line == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign label = line | split: '|' | first | strip -%}
              {%- assign url = line | split: '|' | last | strip -%}
              <a href="{{ url | default: '#' }}">{{ label }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="tp-footer__notes">
    {%- for block in section.blocks -%}
      {%- if block.type == 'note' -%}
        <div class="tp-footer__note" {{ block.shopify_attributes }}>
          <strong>{{ block.settings.title }}</strong><br>{{ block.settings.text }}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="tp-footer__bottom">
    <div class="tp-footer__copyright">{{ section.settings.copyright }}</div>
    {%- if socials.size > 0 -%}
      <div class="tp-footer__socials">
        {%- for block in socials -%}
          <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .tp-footer {
    background: var(--tp-cream);
    color: var(--tp-ink);
    font-family: var(--tp-sans);
    padding-top: 64px;
    border-top: 1px solid var(--tp-line);
  }

  .tp-footer__top,
  .tp-footer__notes,
  .tp-footer__bottom {
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--tp-gutter);
    box-sizing: border-box;
  }

  .tp-footer * {
    box-sizing: border-box;
  }

  .tp-footer a {
    color: inherit;
    text-decoration: none;
  }

  .tp-footer a:hover {
    color: var(--tp-wine);
  }

  .tp-footer .tp-btn--solid {
    background: var(--tp-wine);
    color: var(--tp-cream);
  }

  .tp-footer .tp-btn--solid:hover {
    color: var(--tp-cream);
  }

  .tp-footer__top {
    display: flex;
    gap: 72px;
    align-items: flex-start;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--tp-line);
  }

  .tp-footer__brand {
    width: 320px;
    flex: none;
  }

  .tp-footer__wordmark {
    font-size: 15px;
    letter-spacing: 0.34em;
    color: var(--tp-wine);
    margin-bottom: 16px;
  }

  .tp-footer__description {
    font-size: 14px;
    line-height: 1.65;
    color: var(--tp-body);
    margin: 0 0 22px;
  }

  .tp-footer__whatsapp {
    height: 46px;
    padding-inline: 22px;
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .tp-footer__contact {
    font-size: 13px;
    line-height: 1.7;
    color: var(--tp-muted);
    margin-top: 18px;
  }

  .tp-footer__columns {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }

  .tp-footer__column-title {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tp-ink);
    margin-bottom: 16px;
  }

  .tp-footer__column-links {
    display: grid;
    gap: 10px;
    font-size: 14px;
    line-height: 1.4;
  }

  .tp-footer__notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    padding: 32px 0 36px;
    border-bottom: 1px solid var(--tp-line);
  }

  .tp-footer__note {
    font-size: 13px;
    line-height: 1.7;
    color: var(--tp-body);
  }

  .tp-footer__note strong {
    font-weight: 500;
    color: var(--tp-ink);
  }

  .tp-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 26px 0 30px;
  }

  .tp-footer__copyright {
    font-size: 12px;
    color: var(--tp-muted);
  }

  .tp-footer__socials {
    display: flex;
    gap: 22px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 899px) {
    .tp-footer {
      padding-top: 36px;
    }

    .tp-footer__top {
      flex-direction: column;
      gap: 28px;
      padding-bottom: 0;
      border-bottom: none;
    }

    .tp-footer__brand {
      width: auto;
    }

    .tp-footer__whatsapp {
      display: flex;
      width: 100%;
      margin-bottom: 0;
    }

    .tp-footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 26px 16px;
      padding-bottom: 26px;
      border-bottom: 1px solid var(--tp-line);
    }

    .tp-footer__column-title {
      margin-bottom: 12px;
    }

    .tp-footer__column-links {
      gap: 9px;
    }

    .tp-footer__notes {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-block: 22px 20px;
    }

    .tp-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding-block: 20px 28px;
    }

    .tp-footer__socials {
      order: -1;
      gap: 18px;
    }
  }
{% endstylesheet %}

