{%- liquid
  assign collection = collections[section.settings.collection]
  assign products = collection.products
  assign limit = section.settings.products_to_show
-%}

<section class="tp-section tp-section--blue tp-products">
  <div class="tp-section-head">
    {%- if section.settings.heading != blank -%}
      <h2 class="tp-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link | default: collection.url | default: '#' }}" class="tp-link-caps">
        {{- section.settings.link_label -}}
      </a>
    {%- endif -%}
  </div>

  <div class="tp-products__grid">
    {%- for product in products limit: limit -%}
      <div class="tp-products__card">
        <a href="{{ product.url }}" class="tp-products__media-link">
          <div class="tp-media tp-products__media">
            {%- if product.featured_image != blank -%}
              {{
                product.featured_image
                | image_url: width: 800
                | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 45vw, 22vw', widths: '300,500,800'
              }}
            {%- else -%}
              <div class="tp-media__placeholder">{{ product.title }}</div>
            {%- endif -%}
          </div>
          {%- assign badge = product.tags | first -%}
          {%- if badge != blank -%}
            <div class="tp-products__badge">{{ badge }}</div>
          {%- endif -%}
        </a>

        <div class="tp-products__body">
          <a href="{{ product.url }}" class="tp-products__title">{{ product.title }}</a>
          {%- if product.type != blank -%}
            <div class="tp-products__meta">{{ product.type }}</div>
          {%- endif -%}
          <div class="tp-products__price">
            {%- if section.settings.price_prefix != blank -%}
              <span class="tp-products__price-label">{{ section.settings.price_prefix }}</span>
            {%- endif -%}
            {{ product.price | money }}
          </div>
          <a href="{{ product.url }}" class="tp-products__cta">
            <span>{{ section.settings.cta_label }}</span>
            <span class="tp-products__cta-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="tp-products__card">
          <div class="tp-media tp-products__media">
            <div class="tp-media__placeholder">Selecione uma coleção</div>
          </div>
          <div class="tp-products__body">
            <div class="tp-products__title">Produto</div>
            <div class="tp-products__price">{{ 18000 | money }}</div>
          </div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .tp-products {
    padding-block: 72px 80px;
  }

  .tp-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .tp-products__media-link {
    position: relative;
    display: block;
  }

  /* Nesta faixa o texto ficava solto sobre o azul, sem nada que o
     ancorasse. Cada produto passa a ser um cartão creme de verdade: a
     mesma linguagem de canto das outras seções, agora aplicada ao card
     inteiro em vez de só à foto. */
  .tp-products__card {
    display: flex;
    flex-direction: column;
    background: var(--tp-cream);
    border-radius: 18px;
    overflow: hidden;
  }

  .tp-products__media {
    height: 320px;
  }

  .tp-products__badge {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 6px 12px;
    background: rgba(61, 39, 34, 0.72);
    color: var(--tp-cream);
    font-size: 12px;
    letter-spacing: 0.04em;
    border-radius: 999px;
    pointer-events: none;
  }

  .tp-products__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 16px 18px 18px;
  }

  .tp-section .tp-products__title {
    display: block;
    font-size: 16px;
    line-height: 1.35;
    color: var(--tp-ink);
  }

  .tp-products__meta {
    font-size: 13px;
    color: var(--tp-muted);
    margin-top: 3px;
  }

  /* O preço é o dado que se procura, então ganha a serifada — e o "Total"
     sai da frente do número, que antes quebrava linha no card estreito. */
  .tp-products__price {
    font-family: var(--tp-serif);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.15;
    color: var(--tp-ink);
    margin-top: 10px;
  }

  .tp-products__price-label {
    display: block;
    font-family: var(--tp-sans);
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-muted);
    margin-bottom: 3px;
  }

  /* Empurrado para o fim do card: com títulos de alturas diferentes, os
     rodapés dos quatro cartões param na mesma linha. */
  .tp-section .tp-products__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--tp-line);
    font-size: 14px;
    font-weight: 500;
    color: var(--tp-wine);
  }

  .tp-products__cta-arrow {
    transition: transform 0.2s ease;
  }

  .tp-products__card:hover .tp-products__cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .tp-products__cta-arrow {
      transition: none;
    }
  }

  @media (max-width: 1100px) {
    .tp-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tp-products__media {
      height: 260px;
    }
  }

  @media (max-width: 899px) {
    .tp-products {
      padding-block: 34px 36px;
    }

    .tp-products__card {
      border-radius: 12px;
    }

    /* Proporção em vez de altura fixa: a foto acompanha a largura da
       coluna em qualquer tela em vez de achatar. */
    .tp-products__media {
      height: auto;
      aspect-ratio: 4 / 5;
    }
  }

  @media (max-width: 749px) {
    .tp-products__body {
      padding: 13px 14px 15px;
    }

    .tp-section .tp-products__title {
      font-size: 15px;
    }

    .tp-products__price {
      font-size: 19px;
      margin-top: 8px;
    }

    .tp-section .tp-products__cta {
      padding-top: 12px;
      font-size: 13px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Mais procurados",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Mais procurados"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Produtos exibidos",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Rótulo do preço",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto do link do produto",
      "default": "Comprar agora"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link do topo",
      "default": "Ver todos os produtos"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Destino do link do topo"
    }
  ],
  "presets": [
    {
      "name": "TP — Mais procurados"
    }
  ]
}
{% endschema %}
