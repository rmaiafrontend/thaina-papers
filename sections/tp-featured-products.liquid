{%- liquid
  assign collection = collections[section.settings.collection]
  assign products = collection.products
  assign limit = section.settings.products_to_show
-%}

<section class="tp-section tp-section--blue tp-products">
  <div class="tp-section-head">
    {%- if section.settings.heading != blank -%}
      <h2 class="tp-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link | default: collection.url | default: '#' }}" class="tp-link-caps">
        {{- section.settings.link_label -}}
      </a>
    {%- endif -%}
  </div>

  <div class="tp-products__grid">
    {%- for product in products limit: limit -%}
      <div class="tp-products__card">
        <a href="{{ product.url }}" class="tp-products__media-link">
          <div class="tp-media tp-products__media">
            {%- if product.featured_image != blank -%}
              {{
                product.featured_image
                | image_url: width: 800
                | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 45vw, 22vw', widths: '300,500,800'
              }}
            {%- else -%}
              <div class="tp-media__placeholder">{{ product.title }}</div>
            {%- endif -%}
          </div>
          {%- liquid
            # Pegava a primeira tag crua e imprimia como estava: o card mostrava
            # "arquivo-digital". Agora usa o mesmo vocabulário dos hubs.
            assign badge = ''
            if product.tags contains 'template-canva'
              assign badge = 'Template Canva'
            elsif product.tags contains 'arte-digital'
              assign badge = 'Arte digital'
            elsif product.tags contains 'arquivo-digital'
              assign badge = 'Arquivo digital'
            elsif product.requires_shipping == false
              assign badge = 'Arquivo digital'
            endif
          -%}
          {%- if badge != blank -%}
            <div class="tp-products__badge">{{ badge }}</div>
          {%- endif -%}
        </a>

        <div class="tp-products__body">
          <a href="{{ product.url }}" class="tp-products__title">{{ product.title }}</a>
          {%- if product.type != blank -%}
            <div class="tp-products__meta">{{ product.type }}</div>
          {%- endif -%}
          <div class="tp-products__price">
            {{- section.settings.price_prefix }} {{ product.price | money -}}
          </div>
          <a href="{{ product.url }}" class="tp-products__cta">
            {{- section.settings.cta_label }} &rarr;
          </a>
        </div>
      </div>
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="tp-products__card">
          <div class="tp-media tp-products__media">
            <div class="tp-media__placeholder">Selecione uma coleção</div>
          </div>
          <div class="tp-products__body">
            <div class="tp-products__title">Produto</div>
            <div class="tp-products__price">{{ 18000 | money }}</div>
          </div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .tp-products {
    padding-block: 72px 80px;
  }

  .tp-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .tp-products__media-link {
    position: relative;
    display: block;
  }

  .tp-products__media {
    height: 320px;
    border-radius: 18px;
  }

  .tp-products__badge {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 6px 12px;
    background: rgba(61, 39, 34, 0.72);
    color: var(--tp-cream);
    font-size: 12px;
    letter-spacing: 0.04em;
    border-radius: 999px;
    pointer-events: none;
  }

  .tp-products__body {
    padding-top: 12px;
  }

  /* Título, preço e chamada são um bloco só de informação do produto:
     ficam próximos entre si para ler como uma unidade. */
  .tp-section .tp-products__title {
    display: block;
    font-size: 16px;
    line-height: 1.28;
    color: var(--tp-ink);
  }

  .tp-products__meta {
    font-size: 13px;
    color: var(--tp-muted);
    margin-top: 2px;
  }

  .tp-products__price {
    font-size: 17px;
    font-weight: 500;
    color: var(--tp-ink);
    margin-top: 5px;
  }

  .tp-section .tp-products__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--tp-wine);
  }

  @media (max-width: 1100px) {
    .tp-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tp-products__media {
      height: 260px;
    }
  }

  @media (max-width: 899px) {
    .tp-products {
      padding-block: 34px 36px;
    }

    .tp-products__media {
      height: 210px;
      border-radius: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Mais procurados",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Mais procurados"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Produtos exibidos",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Prefixo do preço",
      "default": "Total:"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto do link do produto",
      "default": "Comprar agora"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link do topo",
      "default": "Ver todos os produtos"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Destino do link do topo"
    }
  ],
  "presets": [
    {
      "name": "TP — Mais procurados"
    }
  ]
}
{% endschema %}
