{%- liquid
  assign colecoes = collections | sort: 'title'
-%}

<section class="tp-section tp-listcol">
  <div class="tp-listcol__head">
    <div class="tp-listcol__breadcrumb">
      <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home }}</a>
      <span aria-hidden="true"> / </span>
      <span>{{ section.settings.breadcrumb_label }}</span>
    </div>
    <h1 class="tp-listcol__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.description != blank -%}
      <div class="tp-listcol__lead">{{ section.settings.description }}</div>
    {%- endif -%}
  </div>

  <div class="tp-listcol__grid">
    {%- for colecao in colecoes -%}
      {%- if colecao.all_products_count == 0 and section.settings.hide_empty -%}
        {%- continue -%}
      {%- endif -%}
      <a href="{{ colecao.url }}" class="tp-listcol__card">
        <div class="tp-media tp-listcol__media">
          {%- if colecao.image -%}
            {{ colecao.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 45vw, 30vw', widths: '300,500,800' }}
          {%- elsif colecao.products.first.featured_image -%}
            {{ colecao.products.first.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 45vw, 30vw', widths: '300,500,800' }}
          {%- else -%}
            <div class="tp-media__placeholder">{{ colecao.title }}</div>
          {%- endif -%}
        </div>
        <div class="tp-listcol__body">
          <div class="tp-listcol__name">{{ colecao.title }}</div>
          <div class="tp-listcol__count">
            {{ colecao.all_products_count }}
            {%- if colecao.all_products_count == 1 %} produto{% else %} produtos{% endif -%}
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .tp-listcol {
    padding-block: 44px 72px;
  }

  .tp-listcol * {
    box-sizing: border-box;
  }

  .tp-listcol a {
    color: inherit;
    text-decoration: none;
  }

  .tp-listcol__breadcrumb {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-muted);
    margin-bottom: 14px;
  }

  .tp-listcol__breadcrumb a:hover {
    color: var(--tp-ink);
  }

  .tp-listcol__title {
    font-family: var(--tp-serif);
    font-weight: 400;
    font-size: 46px;
    line-height: 1.14;
    margin: 0 0 16px;
  }

  .tp-listcol__lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--tp-body);
    max-width: 60ch;
  }

  .tp-listcol__lead p {
    margin: 0;
  }

  .tp-listcol__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 24px;
    padding-top: 36px;
  }

  /* Mesma linguagem de card das seções de produto. */
  .tp-listcol__media {
    height: 260px;
    border-radius: 18px;
  }

  .tp-listcol__body {
    padding-top: 12px;
  }

  .tp-listcol__name {
    font-family: var(--tp-serif);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.28;
    color: var(--tp-ink);
  }

  .tp-listcol__count {
    font-size: 13px;
    color: var(--tp-muted);
    margin-top: 5px;
  }

  .tp-listcol__card:hover .tp-listcol__name {
    color: var(--tp-wine);
  }

  @media (max-width: 1100px) {
    .tp-listcol__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .tp-listcol {
      padding-block: 28px 44px;
    }

    .tp-listcol__title {
      font-size: 30px;
    }

    .tp-listcol__media {
      height: auto;
      aspect-ratio: 4 / 5;
      border-radius: 12px;
    }

    .tp-listcol__grid {
      gap: 22px 16px;
      padding-top: 24px;
    }

    .tp-listcol__name {
      font-size: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Lista de coleções",
  "settings": [
    { "type": "text", "id": "breadcrumb_home", "label": "Breadcrumb — início", "default": "Início" },
    { "type": "text", "id": "breadcrumb_label", "label": "Breadcrumb — atual", "default": "Coleções" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Coleções" },
    { "type": "richtext", "id": "description", "label": "Texto" },
    { "type": "checkbox", "id": "hide_empty", "label": "Esconder coleções sem produto", "default": true }
  ]
}
{% endschema %}
