{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign can_add_to_cart = false
  assign add_to_cart_text = 'products.product.unavailable' | t

  if variant
    if variant.available
      assign can_add_to_cart = true
      assign add_to_cart_text = section.settings.add_to_cart_label | default: 'Adicionar ao pedido'
    else
      assign add_to_cart_text = 'products.product.sold_out' | t
    endif
  endif

  assign media_list = product.media
  assign main_media = media_list.first
  assign thumb_media = media_list | slice: 1, 3

  assign product_title = product.title | default: section.settings.title_fallback
  assign info_blocks = section.blocks | where: 'type', 'info'
  assign note_blocks = section.blocks | where: 'type', 'note_col'
-%}

<div class="tp-pdig">
  <div class="tp-pdig__notice">
    <div class="tp-pdig__notice-inner">
      {%- if section.settings.notice_label != blank -%}
        <div class="tp-pdig__notice-label">{{ section.settings.notice_label }}</div>
      {%- endif -%}
      <div class="tp-pdig__notice-divider" aria-hidden="true"></div>
      {%- if section.settings.notice_text != blank -%}
        <div class="tp-pdig__notice-text">{{ section.settings.notice_text }}</div>
      {%- endif -%}
    </div>
  </div>

  <div class="tp-pdig__breadcrumb">
    <a href="{{ routes.root_url }}">Início</a>
    {%- if section.settings.breadcrumb_tail != blank -%}
      <span aria-hidden="true"> / </span>
      <span>{{ section.settings.breadcrumb_tail }}</span>
    {%- endif -%}
  </div>

  <div class="tp-pdig__main">
    <div class="tp-pdig__gallery">
      <div class="tp-media tp-pdig__gallery-main" data-tp-pdig-gallery-main>
        {%- if main_media -%}
          {{
            main_media
            | image_url: width: 1200
            | image_tag: loading: 'eager', sizes: '(max-width: 899px) 100vw, 45vw', widths: '600,900,1200', id: 'tp-pdig-gallery-main-img'
          }}
        {%- else -%}
          <div class="tp-media__placeholder">{{ product_title }}</div>
        {%- endif -%}
      </div>

      {%- if thumb_media.size > 0 -%}
        <div class="tp-pdig__gallery-thumbs">
          {%- for media in thumb_media -%}
            <button
              type="button"
              class="tp-media tp-pdig__gallery-thumb"
              data-tp-pdig-gallery-thumb
              data-full="{{ media | image_url: width: 1200 }}"
              aria-label="Ver imagem {{ forloop.index }}"
            >
              {{ media | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,300,400' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="tp-pdig__buybox">
      <h1 class="tp-pdig__title">{{ product_title }}</h1>

      {%- if section.settings.short_description != blank -%}
        <div class="tp-pdig__lead">{{ section.settings.short_description }}</div>
      {%- endif -%}

      <div class="tp-pdig__price">{{ product.price | money }}</div>

      {%- if section.settings.delivery_note != blank -%}
        <div class="tp-pdig__delivery-note">{{ section.settings.delivery_note }}</div>
      {%- endif -%}

      <div class="tp-pdig__actions">
        <product-form-component
          data-quantity-default="1"
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          data-product-url="{{ product.url }}"
          on:submit="/handleSubmit"
        >
          <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
          {%- form 'product', product, id: 'tp-product-digital-form', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
            <add-to-cart-component ref="addToCartButtonContainer">
              <button
                type="submit"
                name="add"
                ref="addToCartButton"
                on:click="/handleClick"
                class="tp-btn tp-btn--solid tp-pdig__submit"
                {% unless can_add_to_cart %}disabled{% endunless %}
              >
                {{- add_to_cart_text -}}
              </button>
            </add-to-cart-component>
          {%- endform -%}
        </product-form-component>

        {%- if section.settings.contact_label != blank -%}
          <a href="{{ section.settings.contact_link | default: '#' }}" class="tp-btn tp-btn--outline tp-pdig__contact">
            {{- section.settings.contact_label -}}
          </a>
        {%- endif -%}
      </div>

      {%- if info_blocks.size > 0 -%}
        <div class="tp-pdig__infos">
          {%- for block in info_blocks -%}
            <div class="tp-pdig__info" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <div class="tp-pdig__info-title">{{ block.settings.title }}</div>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="tp-pdig__info-body">{{ block.settings.body }}</div>
              {%- endif -%}
              {%- assign info_items = block.settings.items | newline_to_br | split: '<br />' -%}
              {%- assign has_items = false -%}
              {%- for raw_item in info_items -%}
                {%- if raw_item != blank -%}
                  {%- assign has_items = true -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if has_items -%}
                <div class="tp-pdig__info-list">
                  {%- for raw_item in info_items -%}
                    {%- assign item = raw_item | strip -%}
                    {%- if item != blank -%}
                      <div>{{ item }}</div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
              {%- if block.settings.note != blank -%}
                <p class="tp-pdig__info-note">{{ block.settings.note }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if note_blocks.size > 0 -%}
    <div class="tp-pdig__band">
      <div class="tp-pdig__band-grid">
        {%- for block in note_blocks -%}
          <div class="tp-pdig__note-col" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <div class="tp-pdig__note-title">{{ block.settings.title }}</div>
            {%- endif -%}

            {%- assign note_items = block.settings.items | newline_to_br | split: '<br />' -%}
            {%- assign has_note_items = false -%}
            {%- for raw_item in note_items -%}
              {%- if raw_item != blank -%}
                {%- assign has_note_items = true -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if has_note_items -%}
              <div class="tp-pdig__note-list">
                {%- for raw_item in note_items -%}
                  {%- assign item = raw_item | strip -%}
                  {%- if item != blank -%}
                    <div>{{ item }}</div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if block.settings.body != blank -%}
              <div class="tp-pdig__note-body">{{ block.settings.body }}</div>
            {%- endif -%}

            {%- if block.settings.note != blank -%}
              <p class="tp-pdig__note-fine">{{ block.settings.note }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{%- if section.settings.announcement_override != blank -%}
  <script>
    (function () {
      var text = {{ section.settings.announcement_override | json }};
      var desktop = document.querySelector('.tp-header__announce--desktop');
      var mobile = document.querySelector('.tp-header__announce--mobile');
      if (desktop) desktop.textContent = text;
      if (mobile) mobile.textContent = text;
    })();
  </script>
{%- endif -%}

<script>
  (function () {
    document.querySelectorAll('[data-tp-pdig-gallery-thumb]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var main = btn.closest('.tp-pdig')?.querySelector('[data-tp-pdig-gallery-main] img');
        var full = btn.getAttribute('data-full');
        if (main && full) {
          main.src = full;
          main.removeAttribute('srcset');
        }
      });
    });
  })();
</script>

{% stylesheet %}
  .tp-pdig {
    font-family: var(--tp-sans);
    color: var(--tp-ink);
    background: var(--tp-cream);
  }

  .tp-pdig * {
    box-sizing: border-box;
  }

  .tp-pdig a,
  .tp-pdig button {
    color: inherit;
    font-family: var(--tp-sans);
  }

  .tp-pdig a {
    text-decoration: none;
  }

  .tp-pdig .tp-btn--solid {
    background: var(--tp-wine);
    color: var(--tp-cream);
  }

  .tp-pdig .tp-btn--outline {
    background: transparent;
    border: 1px solid var(--tp-line-strong);
    color: var(--tp-ink);
  }

  /* Faixa vinho de produto digital — banda de cor cheia, container no filho */
  .tp-pdig__notice {
    background: var(--tp-wine);
    color: var(--tp-cream);
  }

  .tp-pdig__notice-inner {
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--tp-gutter);
    padding-block: 16px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tp-pdig__notice-label {
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    flex: none;
  }

  .tp-pdig__notice-divider {
    width: 1px;
    height: 16px;
    background: rgba(250, 248, 243, 0.4);
    flex: none;
  }

  .tp-pdig__notice-text {
    font-size: 14px;
  }

  .tp-pdig__breadcrumb {
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--tp-gutter);
    padding-block: 26px 0;
    box-sizing: border-box;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-muted);
  }

  .tp-pdig__breadcrumb a:hover {
    color: var(--tp-wine);
  }

  .tp-pdig__main {
    display: flex;
    gap: 56px;
    align-items: flex-start;
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--tp-gutter);
    padding-block: 26px 64px;
    box-sizing: border-box;
  }

  .tp-pdig__gallery {
    flex: 1;
    min-width: 0;
  }

  .tp-pdig__gallery-main {
    height: 520px;
  }

  .tp-pdig__gallery-thumbs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 12px;
  }

  .tp-pdig__gallery-thumb {
    height: 150px;
    padding: 0;
    border: none;
    cursor: pointer;
  }

  .tp-pdig__buybox {
    width: 500px;
    flex: none;
  }

  .tp-pdig__title {
    font-family: var(--tp-serif);
    font-weight: 400;
    font-size: 38px;
    line-height: 1.16;
    margin: 0 0 12px;
  }

  .tp-pdig__lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--tp-body);
    margin: 0 0 22px;
  }

  .tp-pdig__lead p {
    margin: 0;
  }

  .tp-pdig__price {
    font-size: 30px;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .tp-pdig__delivery-note {
    font-size: 13px;
    color: var(--tp-muted);
    margin-bottom: 24px;
  }

  .tp-pdig__actions {
    display: grid;
    gap: 10px;
    margin-bottom: 26px;
  }

  .tp-pdig__actions product-form-component,
  .tp-pdig__actions form {
    display: block;
  }

  .tp-pdig__submit,
  .tp-pdig__contact {
    width: 100%;
    height: 54px;
    font-size: 15px;
  }

  .tp-pdig__submit {
    letter-spacing: 0.04em;
  }

  .tp-pdig__submit[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .tp-pdig__info {
    border-top: 1px solid var(--tp-line);
    padding-block: 20px;
  }

  .tp-pdig__info:last-child {
    border-bottom: 1px solid var(--tp-line);
  }

  .tp-pdig__info-title {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-wine);
    margin-bottom: 10px;
  }

  .tp-pdig__info-body {
    font-size: 15px;
    line-height: 1.65;
    color: var(--tp-ink);
  }

  .tp-pdig__info-body p {
    margin: 0 0 8px;
  }

  .tp-pdig__info-body p:last-child {
    margin-bottom: 0;
  }

  .tp-pdig__info-list {
    display: grid;
    gap: 7px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--tp-ink);
  }

  .tp-pdig__info-note {
    font-size: 14px;
    line-height: 1.6;
    color: var(--tp-muted);
    margin: 8px 0 0;
  }

  /* Banda final — cor cheia, container no filho */
  .tp-pdig__band {
    background: var(--tp-stone);
  }

  .tp-pdig__band-grid {
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--tp-gutter);
    padding-block: 56px 60px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .tp-pdig__note-title {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-wine);
    margin-bottom: 14px;
  }

  .tp-pdig__note-list {
    display: grid;
    gap: 10px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--tp-ink);
  }

  .tp-pdig__note-body {
    font-size: 15px;
    line-height: 1.65;
    color: var(--tp-ink);
  }

  .tp-pdig__note-body p {
    margin: 0 0 8px;
  }

  .tp-pdig__note-body p:last-child {
    margin-bottom: 0;
  }

  .tp-pdig__note-fine {
    font-size: 14px;
    line-height: 1.6;
    color: var(--tp-muted);
    margin: 10px 0 0;
  }

  @media (max-width: 1100px) {
    .tp-pdig__main {
      gap: 32px;
    }

    .tp-pdig__buybox {
      width: 420px;
    }

    .tp-pdig__band-grid {
      gap: 24px;
    }
  }

  @media (max-width: 899px) {
    .tp-pdig__notice-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .tp-pdig__notice-divider {
      display: none;
    }

    .tp-pdig__breadcrumb {
      padding-block: 16px 0;
      font-size: 11px;
    }

    .tp-pdig__main {
      flex-direction: column;
      gap: 28px;
      padding-block: 16px 40px;
    }

    .tp-pdig__buybox {
      width: auto;
    }

    .tp-pdig__gallery {
      flex: none;
      width: 100%;
    }

    .tp-pdig__gallery-main {
      height: 380px;
    }

    .tp-pdig__gallery-thumb {
      height: 96px;
    }

    .tp-pdig__title {
      font-size: 28px;
    }

    .tp-pdig__band-grid {
      padding-block: 36px 40px;
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Produto digital",
  "settings": [
    {
      "type": "text",
      "id": "announcement_override",
      "label": "Aviso do topo (só nesta página)",
      "default": "Templates liberados na hora · Edite no Canva quantas vezes quiser"
    },
    {
      "type": "header",
      "content": "Faixa de produto digital"
    },
    {
      "type": "text",
      "id": "notice_label",
      "label": "Rótulo da faixa",
      "default": "Produto digital"
    },
    {
      "type": "text",
      "id": "notice_text",
      "label": "Texto da faixa",
      "default": "Nenhum item físico será enviado."
    },
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "text",
      "id": "breadcrumb_tail",
      "label": "Breadcrumb (depois de \"Início /\")",
      "default": "Templates Canva / Formaturas"
    },
    {
      "type": "text",
      "id": "title_fallback",
      "label": "Título (quando não houver produto)",
      "default": "Kit de formatura no Canva"
    },
    {
      "type": "richtext",
      "id": "short_description",
      "label": "Descrição curta",
      "default": "<p>Você edita, exporta e imprime onde quiser — sem esperar prazo de criação.</p>"
    },
    {
      "type": "text",
      "id": "delivery_note",
      "label": "Nota de entrega/licença",
      "default": "Entrega imediata por link · Licença de uso pessoal"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Botão — adicionar ao pedido",
      "default": "Adicionar ao pedido"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Botão — algo exclusivo",
      "default": "Quero algo exclusivo"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Link do botão de contato"
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Bloco de informação",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "O que você recebe"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Texto"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Lista (um item por linha)"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Observação (menor, cinza)"
        }
      ]
    },
    {
      "type": "note_col",
      "name": "Coluna da banda final",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Como usar"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Lista (um item por linha)"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Texto"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Observação (menor, cinza)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP — Produto digital",
      "blocks": [
        { "type": "info" },
        { "type": "info" },
        { "type": "info" },
        { "type": "info" },
        { "type": "note_col" },
        { "type": "note_col" },
        { "type": "note_col" }
      ]
    }
  ]
}
{% endschema %}
