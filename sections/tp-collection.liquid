{%- liquid
  assign packages = section.blocks | where: 'type', 'package'
  assign products = collection.products
-%}

<div class="tp-hub">
  <div class="tp-hub__intro">
    <div class="tp-hub__col">
      <div class="tp-hub__breadcrumb">
        <a href="{{ routes.root_url }}">Início</a>
        <span aria-hidden="true"> / </span>
        <span>{{ collection.title }}</span>
      </div>
      <h1 class="tp-hub__title">{{ section.settings.heading | default: collection.title }}</h1>
      {%- if section.settings.description != blank -%}
        <div class="tp-hub__lead">{{ section.settings.description }}</div>
      {%- elsif collection.description != blank -%}
        <div class="tp-hub__lead">{{ collection.description }}</div>
      {%- endif -%}
    </div>
    <div class="tp-media tp-hub__hero-media">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 900
          | image_tag: loading: 'eager', sizes: '(max-width: 899px) 100vw, 420px', widths: '400,650,900'
        }}
      {%- elsif collection.image -%}
        {{
          collection.image
          | image_url: width: 900
          | image_tag: loading: 'eager', sizes: '(max-width: 899px) 100vw, 420px', widths: '400,650,900'
        }}
      {%- else -%}
        <div class="tp-media__placeholder">{{ collection.title }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- if packages.size > 0 -%}
    <div class="tp-hub__packages">
      {%- for block in packages -%}
        <a href="{{ block.settings.link | default: '#' }}" class="tp-hub__package" {{ block.shopify_attributes }}>
          <div class="tp-hub__package-eyebrow">Pacote</div>
          <div class="tp-hub__package-title">{{ block.settings.title }}</div>
          <div class="tp-hub__package-text">{{ block.settings.description }}</div>
          <div class="tp-hub__package-price">{{ block.settings.price }}</div>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="tp-hub__catalog">
    <div class="tp-hub__filters">
      <div class="tp-hub__filter-group">
        <span class="tp-hub__filter-label">Tipo de entrega</span>
        <button type="button" class="tp-hub__pill tp-hub__pill--active" data-tp-filter="all">Todos</button>
        <button type="button" class="tp-hub__pill" data-tp-filter="fisico">Produto físico</button>
        <button type="button" class="tp-hub__pill" data-tp-filter="arquivo-digital">Arquivo digital</button>
        <button type="button" class="tp-hub__pill" data-tp-filter="arte-digital">Arte digital pronta</button>
        <button type="button" class="tp-hub__pill" data-tp-filter="template-canva">Template Canva</button>
      </div>
      <div class="tp-hub__count" data-tp-count>{{ collection.products_count }} produtos</div>
    </div>

    <div class="tp-hub__grid" data-tp-grid>
      {%- for product in products -%}
        {%- liquid
          assign delivery = 'fisico'
          assign badge = 'Produto físico'
          if product.tags contains 'template-canva'
            assign delivery = 'template-canva'
            assign badge = 'Template Canva'
          elsif product.tags contains 'arte-digital'
            assign delivery = 'arte-digital'
            assign badge = 'Arte digital'
          elsif product.tags contains 'arquivo-digital'
            assign delivery = 'arquivo-digital'
            assign badge = 'Arquivo digital'
          elsif product.requires_shipping == false
            assign delivery = 'arquivo-digital'
            assign badge = 'Arquivo digital'
          endif
        -%}
        <div class="tp-hub__card" data-tp-card data-delivery="{{ delivery }}">
          <a href="{{ product.url }}" class="tp-hub__card-media-link">
            <div class="tp-media tp-hub__card-media">
              {%- if product.featured_image -%}
                {{
                  product.featured_image
                  | image_url: width: 700
                  | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 45vw, 22vw', widths: '300,500,700'
                }}
              {%- else -%}
                <div class="tp-media__placeholder">{{ product.title }}</div>
              {%- endif -%}
              <div class="tp-hub__card-badge{% if delivery != 'fisico' %} tp-hub__card-badge--accent{% endif %}">{{ badge }}</div>
            </div>
          </a>
          <div class="tp-hub__card-body">
            <div class="tp-hub__card-title">{{ product.title }}</div>
            {%- if product.type != blank -%}
              <div class="tp-hub__card-meta">{{ product.type }}</div>
            {%- endif -%}
            <div class="tp-hub__card-price">{{ product.price | money }}</div>
            <a href="{{ product.url }}" class="tp-hub__card-link">Ver produto &rarr;</a>
          </div>
        </div>
      {%- else -%}
        <p class="tp-hub__empty">Nenhum produto nesta coleção ainda.</p>
      {%- endfor -%}
    </div>
  </div>

  <div class="tp-hub__cta">
    <div class="tp-hub__cta-copy">
      <div class="tp-hub__cta-title">{{ section.settings.cta_heading | default: 'Não achou a peça que você imaginou?' }}</div>
      {%- if section.settings.cta_description != blank -%}
        <p class="tp-hub__cta-text">{{ section.settings.cta_description }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link | default: '#' }}" class="tp-btn tp-btn--light tp-hub__cta-btn">
        {{- section.settings.cta_label -}}
      </a>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !root.classList.contains('tp-hub')) {
      root = document.querySelector('.tp-hub');
    }
    var pills = root.querySelectorAll('[data-tp-filter]');
    var cards = root.querySelectorAll('[data-tp-card]');
    var countEl = root.querySelector('[data-tp-count]');

    pills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        pills.forEach(function (p) {
          p.classList.remove('tp-hub__pill--active');
        });
        pill.classList.add('tp-hub__pill--active');

        var filter = pill.dataset.tpFilter;
        var visible = 0;
        cards.forEach(function (card) {
          var match = filter === 'all' || card.dataset.delivery === filter;
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        if (countEl) countEl.textContent = visible + (visible === 1 ? ' produto' : ' produtos');
      });
    });
  })();
</script>

{% stylesheet %}
  .tp-hub {
    font-family: var(--tp-sans);
    color: var(--tp-ink);
  }

  .tp-hub * {
    box-sizing: border-box;
  }

  .tp-hub a {
    color: inherit;
    text-decoration: none;
  }

  .tp-hub .tp-btn--light {
    background: var(--tp-cream);
    color: var(--tp-ink);
  }

  .tp-hub__intro {
    display: flex;
    gap: 60px;
    align-items: flex-end;
    padding: 56px var(--tp-gutter) 44px;
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
  }

  .tp-hub__col {
    flex: 1;
    min-width: 0;
  }

  .tp-hub__breadcrumb {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-muted);
    margin-bottom: 14px;
  }

  .tp-hub__breadcrumb a:hover {
    color: var(--tp-wine);
  }

  .tp-hub__title {
    font-family: var(--tp-serif);
    font-weight: 500;
    font-size: 46px;
    line-height: 1.14;
    margin: 0 0 16px;
    max-width: 620px;
  }

  .tp-hub__lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--tp-body);
    max-width: 540px;
  }

  .tp-hub__lead p {
    margin: 0;
  }

  .tp-hub__lead p + p {
    margin-top: 10px;
  }

  .tp-hub__hero-media {
    flex: none;
    width: 420px;
    height: 260px;
  }

  .tp-hub__packages {
    padding: 0 var(--tp-gutter) 56px;
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .tp-hub__package {
    display: block;
    border: 1px solid var(--tp-line);
    padding: 28px 26px;
    transition: border-color 0.2s ease;
  }

  .tp-hub__package:hover {
    border-color: var(--tp-line-strong);
  }

  .tp-hub__package-eyebrow {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tp-wine);
  }

  .tp-hub__package-title {
    font-family: var(--tp-serif);
    font-size: 26px;
    font-weight: 500;
    margin: 10px 0 6px;
  }

  .tp-hub__package-text {
    font-size: 15px;
    color: var(--tp-body);
    margin-bottom: 16px;
  }

  .tp-hub__package-price {
    font-size: 20px;
    font-weight: 500;
  }

  .tp-hub__catalog {
    background: var(--tp-stone);
    padding: 36px 0 40px;
  }

  .tp-hub__filters,
  .tp-hub__grid {
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--tp-gutter);
    box-sizing: border-box;
  }

  .tp-hub__filters {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 26px;
    flex-wrap: wrap;
  }

  .tp-hub__filter-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tp-hub__filter-label {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-muted);
    margin-right: 6px;
  }

  .tp-hub__pill {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 16px;
    border: 1px solid rgba(36, 33, 31, 0.28);
    background: transparent;
    color: var(--tp-ink);
    font-size: 13px;
    font-family: var(--tp-sans);
    cursor: pointer;
  }

  .tp-hub__pill--active {
    border-color: var(--tp-ink);
    background: var(--tp-ink);
    color: var(--tp-cream);
  }

  .tp-hub__count {
    font-size: 13px;
    color: var(--tp-muted);
    flex: none;
  }

  .tp-hub__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .tp-hub__card-media-link {
    position: relative;
    display: block;
  }

  .tp-hub__card-media {
    height: 300px;
    border-radius: 18px;
  }

  .tp-hub__card-badge {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 6px 12px;
    background: rgba(36, 33, 31, 0.72);
    color: var(--tp-cream);
    font-size: 12px;
    border-radius: 999px;
    pointer-events: none;
  }

  .tp-hub__card-badge--accent {
    background: rgba(93, 14, 9, 0.9);
  }

  .tp-hub__card-body {
    padding-top: 14px;
  }

  .tp-hub__card-title {
    font-size: 16px;
  }

  .tp-hub__card-meta {
    font-size: 13px;
    color: var(--tp-muted);
    margin-top: 3px;
  }

  .tp-hub__card-price {
    font-size: 17px;
    font-weight: 500;
    margin-top: 10px;
  }

  .tp-hub__card-link {
    display: inline-flex;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--tp-wine);
  }

  .tp-hub__empty {
    grid-column: 1 / -1;
    font-size: 15px;
    color: var(--tp-muted);
  }

  .tp-hub__cta {
    padding: 54px var(--tp-gutter) 60px;
    background: var(--tp-ink);
    color: var(--tp-cream);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .tp-hub__cta-copy {
    max-width: 560px;
  }

  .tp-hub__cta-title {
    font-family: var(--tp-serif);
    font-size: 30px;
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 10px;
  }

  .tp-hub__cta-text {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(250, 248, 243, 0.72);
    margin: 0;
  }

  .tp-hub__cta-btn {
    flex: none;
    height: 52px;
    padding-inline: 28px;
    font-size: 14px;
    letter-spacing: 0.06em;
  }

  @media (max-width: 1100px) {
    .tp-hub__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 899px) {
    .tp-hub__intro {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 24px;
      padding-block: 28px 32px;
    }

    .tp-hub__hero-media {
      width: 100%;
      height: 200px;
    }

    .tp-hub__title {
      font-size: 30px;
    }

    .tp-hub__packages {
      grid-template-columns: 1fr;
      padding-bottom: 32px;
    }

    .tp-hub__catalog {
      padding-block: 24px 32px;
    }

    .tp-hub__filters {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }

    .tp-hub__count {
      order: -1;
    }

    .tp-hub__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .tp-hub__card-media {
      height: 220px;
      border-radius: 12px;
    }

    .tp-hub__cta {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 36px 40px;
    }

    .tp-hub__cta-btn {
      width: 100%;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Hub de coleção",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título (padrão: nome da coleção)"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descrição (padrão: descrição da coleção)"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagem de destaque (padrão: imagem da coleção)"
    },
    {
      "type": "header",
      "content": "Chamada final"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Título",
      "default": "Não achou a peça que você imaginou?"
    },
    {
      "type": "textarea",
      "id": "cta_description",
      "label": "Descrição",
      "default": "Cada projeto começa com uma conversa e é desenvolvido especialmente para você."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Botão",
      "default": "Quero algo exclusivo"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link do botão"
    }
  ],
  "blocks": [
    {
      "type": "package",
      "name": "Pacote",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nome",
          "default": "Essential"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descrição",
          "default": "Identidade + convite + papelaria base"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Preço (texto)",
          "default": "R$ 490"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP — Hub de coleção",
      "blocks": [
        { "type": "package" },
        { "type": "package" },
        { "type": "package" }
      ]
    }
  ]
}
{% endschema %}
