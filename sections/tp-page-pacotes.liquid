{%- liquid
  assign plans = section.blocks | where: 'type', 'plan'
  assign features = section.blocks | where: 'type', 'feature'

  assign grid_columns = '1.4fr repeat(' | append: plans.size | append: ', 1fr)'
-%}

<div class="tp-pacotes">
  {%- comment -%}
    Em página própria o cabeçalho é o hero. Embutida noutra tela — o hub de
    Casamentos, por exemplo — ela entra só como tabela, sem repetir o título
    que já está acima.
  {%- endcomment -%}
  {%- if section.settings.show_head -%}
  <div class="tp-pacotes__head">
    <div class="tp-pacotes__breadcrumb">
      <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home }}</a>
      {%- if section.settings.breadcrumb_level_2 != blank -%}
        <span aria-hidden="true">/</span> {{ section.settings.breadcrumb_level_2 }}
      {%- endif -%}
      {%- if section.settings.breadcrumb_level_3 != blank -%}
        <span aria-hidden="true">/</span> {{ section.settings.breadcrumb_level_3 }}
      {%- endif -%}
    </div>

    {%- if section.settings.heading != blank -%}
      <h1 class="tp-pacotes__title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <div class="tp-pacotes__lead">{{ section.settings.intro }}</div>
    {%- endif -%}
  </div>
  {%- else -%}
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="tp-pacotes__compare tp-pacotes__embed-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="tp-pacotes__embed-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="tp-pacotes__embed-lead">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  <div class="tp-pacotes__compare">
    {%- if plans.size > 0 -%}
      <div class="tp-pacotes__table">
        <div class="tp-pacotes__row tp-pacotes__row--head" style="grid-template-columns: {{ grid_columns }};">
          <div class="tp-pacotes__cell tp-pacotes__cell--label"></div>
          {%- for plan in plans -%}
            {%- liquid
              assign head_classes = 'tp-pacotes__cell tp-pacotes__cell--plan'
              if plan.settings.is_featured
                assign head_classes = head_classes | append: ' tp-pacotes__cell--featured'
              endif
            -%}
            <div class="{{ head_classes }}" {{ plan.shopify_attributes }}>
              {%- if plan.settings.name != blank -%}
                <div class="tp-pacotes__plan-name">{{ plan.settings.name }}</div>
              {%- endif -%}
              {%- if plan.settings.price != blank -%}
                <div class="tp-pacotes__plan-price">{{ plan.settings.price }}</div>
              {%- endif -%}
              {%- if plan.settings.tagline != blank -%}
                <div class="tp-pacotes__plan-tagline">{{ plan.settings.tagline }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- for feature in features -%}
          <div
            class="tp-pacotes__row tp-pacotes__row--data"
            style="grid-template-columns: {{ grid_columns }};"
            {{ feature.shopify_attributes }}
          >
            <div class="tp-pacotes__cell tp-pacotes__cell--label">{{ feature.settings.label }}</div>
            {%- for plan in plans -%}
              {%- liquid
                assign value_key = 'v' | append: forloop.index
                assign muted_key = 'muted' | append: forloop.index
                assign cell_classes = 'tp-pacotes__cell tp-pacotes__cell--value'
                if plan.settings.is_featured
                  assign cell_classes = cell_classes | append: ' tp-pacotes__cell--featured'
                endif
                if feature.settings[muted_key]
                  assign cell_classes = cell_classes | append: ' tp-pacotes__cell--muted'
                endif
              -%}
              <div class="{{ cell_classes }}">{{ feature.settings[value_key] }}</div>
            {%- endfor -%}
          </div>
        {%- endfor -%}

        <div class="tp-pacotes__row tp-pacotes__row--cta" style="grid-template-columns: {{ grid_columns }};">
          <div class="tp-pacotes__cell tp-pacotes__cell--label"></div>
          {%- for plan in plans -%}
            {%- liquid
              assign cta_classes = 'tp-pacotes__cell'
              assign btn_classes = 'tp-btn tp-pacotes__btn tp-btn--outline'
              if plan.settings.is_featured
                assign cta_classes = cta_classes | append: ' tp-pacotes__cell--featured'
                assign btn_classes = 'tp-btn tp-pacotes__btn tp-btn--solid'
              endif
            -%}
            <div class="{{ cta_classes }}">
              {%- if plan.settings.cta_label != blank and plan.settings.cta_link != blank -%}
                <a href="{{ plan.settings.cta_link }}" class="{{ btn_classes }}">
                  {{- plan.settings.cta_label -}}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="tp-pacotes__cards">
        {%- for plan in plans -%}
          {%- liquid
            assign plan_index = forloop.index
            assign card_classes = 'tp-pacotes__card'
            if plan.settings.is_featured
              assign card_classes = card_classes | append: ' tp-pacotes__card--featured'
            endif
            assign btn_classes = 'tp-btn tp-pacotes__btn tp-btn--outline'
            if plan.settings.is_featured
              assign btn_classes = 'tp-btn tp-pacotes__btn tp-btn--solid'
            endif
          -%}
          <div class="{{ card_classes }}">
            <div class="tp-pacotes__card-head">
              {%- if plan.settings.name != blank -%}
                <div class="tp-pacotes__plan-name">{{ plan.settings.name }}</div>
              {%- endif -%}
              {%- if plan.settings.price != blank -%}
                <div class="tp-pacotes__plan-price">{{ plan.settings.price }}</div>
              {%- endif -%}
              {%- if plan.settings.tagline != blank -%}
                <div class="tp-pacotes__plan-tagline">{{ plan.settings.tagline }}</div>
              {%- endif -%}
            </div>

            {%- if features.size > 0 -%}
              <div class="tp-pacotes__card-list">
                {%- for feature in features -%}
                  {%- liquid
                    assign value_key = 'v' | append: plan_index
                    assign muted_key = 'muted' | append: plan_index
                    assign value_classes = 'tp-pacotes__card-value'
                    if feature.settings[muted_key]
                      assign value_classes = value_classes | append: ' tp-pacotes__cell--muted'
                    endif
                  -%}
                  <div class="tp-pacotes__card-item">
                    <div class="tp-pacotes__card-label">{{ feature.settings.label }}</div>
                    <div class="{{ value_classes }}">{{ feature.settings[value_key] }}</div>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if plan.settings.cta_label != blank and plan.settings.cta_link != blank -%}
              <a href="{{ plan.settings.cta_link }}" class="{{ btn_classes }}">
                {{- plan.settings.cta_label -}}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.table_note != blank -%}
      <div class="tp-pacotes__note">{{ section.settings.table_note }}</div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.announcement_override != blank -%}
  <script>
    (function () {
      var text = {{ section.settings.announcement_override | json }};
      var desktop = document.querySelector('.tp-header__announce--desktop');
      var mobile = document.querySelector('.tp-header__announce--mobile');
      if (desktop) desktop.textContent = text;
      if (mobile) mobile.textContent = text;
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .tp-pacotes {
    font-family: var(--tp-sans);
    color: var(--tp-ink);
    background: var(--tp-cream);
  }

  .tp-pacotes * {
    box-sizing: border-box;
  }

  .tp-pacotes a {
    color: inherit;
    text-decoration: none;
  }

  /* .tp-btn--solid / --outline são escopados em .tp-section no tp-home.css */
  .tp-pacotes .tp-btn--solid {
    background: var(--tp-wine);
    color: var(--tp-cream);
  }

  .tp-pacotes .tp-btn--outline {
    border-color: var(--tp-line-strong);
    color: var(--tp-ink);
    background: transparent;
  }

  /* ---------- Cabeçalho ---------- */

  .tp-pacotes__head {
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding: 56px var(--tp-gutter) 36px;
    box-sizing: border-box;
  }

  .tp-pacotes__breadcrumb {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-muted);
    margin-block: 0 14px;
  }

  .tp-pacotes__breadcrumb a:hover {
    color: var(--tp-ink);
  }

  .tp-pacotes__title {
    font-family: var(--tp-serif);
    font-weight: 400;
    font-size: 46px;
    line-height: 1.14;
    margin-block: 0 16px;
    max-width: 700px;
  }

  .tp-pacotes__lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--tp-body);
    max-width: 620px;
  }

  .tp-pacotes__lead p {
    margin: 0;
  }

  .tp-pacotes__lead p + p {
    margin-block: 10px 0;
  }

  /* ---------- Tabela comparativa ---------- */

  .tp-pacotes__compare {
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding: 0 var(--tp-gutter) 60px;
    box-sizing: border-box;
  }

  .tp-pacotes__table {
    border: 1px solid var(--tp-line);
  }

  .tp-pacotes__row {
    display: grid;
  }

  .tp-pacotes__cell:not(:last-child) {
    border-right: 1px solid rgba(61, 39, 34, 0.12);
  }

  /* Azul marca o pacote recomendado. */
  .tp-pacotes__cell--featured {
    background: var(--tp-blue);
  }

  .tp-pacotes__cell--muted {
    color: var(--tp-muted);
  }

  /* A tabela respirava demais: 60px por linha de uma linha de texto e 151px
     de cabeçalho. Apertando, ela cabe na tela sem perder legibilidade. */
  .tp-pacotes__row--head .tp-pacotes__cell {
    padding: 22px 22px;
  }

  .tp-pacotes__plan-name {
    font-family: var(--tp-serif);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.15;
    margin-block: 0 4px;
  }

  .tp-pacotes__plan-price {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.15;
    margin-block: 0 4px;
  }

  .tp-pacotes__plan-tagline {
    font-size: 13px;
    line-height: 1.5;
    color: var(--tp-muted);
  }

  .tp-pacotes__row--data {
    border-top: 1px solid rgba(61, 39, 34, 0.12);
    font-size: 15px;
  }

  .tp-pacotes__row--data .tp-pacotes__cell {
    padding: 13px 22px;
    line-height: 1.5;
  }

  .tp-pacotes__row--cta {
    border-top: 1px solid rgba(61, 39, 34, 0.12);
  }

  .tp-pacotes__row--cta .tp-pacotes__cell {
    padding: 18px 22px;
  }

  .tp-pacotes__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 48px;
    padding: 0 16px;
    font-size: 14px;
    text-align: center;
  }

  .tp-pacotes__note {
    font-size: 13px;
    line-height: 1.6;
    color: var(--tp-muted);
    margin-block: 14px 0;
  }

  .tp-pacotes__note p {
    margin: 0;
  }

  .tp-pacotes__note p + p {
    margin-block: 8px 0;
  }

  /* ---------- Cartões (mobile) ---------- */

  .tp-pacotes__cards {
    display: none;
  }

  /* ---------- Responsivo ---------- */

  @media (max-width: 1100px) {
    .tp-pacotes__title {
      font-size: 38px;
    }

    .tp-pacotes__row--head .tp-pacotes__cell,
    .tp-pacotes__row--data .tp-pacotes__cell,
    .tp-pacotes__row--cta .tp-pacotes__cell {
      padding-inline: 18px;
    }

    .tp-pacotes__plan-name {
      font-size: 22px;
    }

    .tp-pacotes__plan-price {
      font-size: 20px;
    }
  }

  @media (max-width: 899px) {
    .tp-pacotes__head {
      padding-block: 32px 24px;
    }

    .tp-pacotes__title {
      font-size: 30px;
      max-width: none;
    }

    .tp-pacotes__lead {
      font-size: 15px;
      max-width: none;
    }

    .tp-pacotes__compare {
      padding-bottom: 40px;
    }

    /* 4 colunas não cabem: a tabela some e cada pacote vira um cartão */
    .tp-pacotes__table {
      display: none;
    }

    .tp-pacotes__cards {
      display: grid;
      gap: 16px;
    }

    .tp-pacotes__card {
      border: 1px solid var(--tp-line);
      padding: 22px 20px 20px;
    }

    .tp-pacotes__card--featured {
      background: var(--tp-blue);
    }

    .tp-pacotes__card-head {
      padding-block: 0 16px;
      border-bottom: 1px solid rgba(61, 39, 34, 0.12);
    }

    .tp-pacotes__card-list {
      display: grid;
      gap: 12px;
      padding-block: 16px 18px;
    }

    .tp-pacotes__card-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--tp-muted);
      margin-block: 0 4px;
    }

    .tp-pacotes__card-value {
      font-size: 14px;
      line-height: 1.55;
    }
  }

  /* Embutida noutra tela ela encosta na seção anterior — no hub de
     Casamentos, na faixa escura do CTA. O respiro que na página própria vinha
     do hero precisa vir daqui. */
  .tp-pacotes__embed-head {
    padding-top: 56px;
    padding-bottom: 0;
  }

  @media (max-width: 749px) {
    .tp-pacotes__embed-head {
      padding-top: 32px;
    }
  }

  .tp-pacotes__embed-title {
    font-family: var(--tp-serif);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 10px;
    color: var(--tp-ink);
  }

  /* O mesmo ritmo do cabeçalho da página própria: título, linha de apoio,
     e um respiro maior antes da tabela começar. */
  .tp-pacotes__embed-lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--tp-body);
    max-width: 62ch;
    margin-bottom: 28px;
  }

  .tp-pacotes__embed-lead p {
    margin: 0;
  }

  .tp-pacotes__embed-head:not(:has(.tp-pacotes__embed-lead)) .tp-pacotes__embed-title {
    margin-bottom: 22px;
  }

  @media (max-width: 749px) {
    .tp-pacotes__embed-title {
      font-size: 24px;
      margin-bottom: 8px;
    }

    .tp-pacotes__embed-lead {
      font-size: 15px;
      margin-bottom: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Pacotes",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_head",
      "label": "Mostrar cabeçalho (breadcrumb e título grande)",
      "default": true,
      "info": "Desmarque ao usar a tabela dentro de outra página, que já tem título próprio."
    },
    {
      "type": "text",
      "id": "announcement_override",
      "label": "Aviso do topo (só nesta página)",
      "default": "Envio para todo o Brasil · Pagamento em até 12x"
    },
    {
      "type": "header",
      "content": "Cabeçalho"
    },
    {
      "type": "text",
      "id": "breadcrumb_home",
      "label": "Breadcrumb — início (link)",
      "default": "Início"
    },
    {
      "type": "text",
      "id": "breadcrumb_level_2",
      "label": "Breadcrumb — nível 2",
      "default": "Casamentos"
    },
    {
      "type": "text",
      "id": "breadcrumb_level_3",
      "label": "Breadcrumb — nível 3",
      "default": "Pacotes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Três formas de começar."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Texto de apoio",
      "default": "<p>Todos os pacotes incluem criação, prévia para aprovação e até 3 solicitações de correção. A diferença está no alcance da papelaria.</p>"
    },
    {
      "type": "header",
      "content": "Tabela comparativa"
    },
    {
      "type": "richtext",
      "id": "table_note",
      "label": "Nota abaixo da tabela",
      "default": "<p>Quantidades adicionais e itens avulsos entram como complemento, com preço de tabela. Frete combinado no atendimento.</p>"
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Pacote",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nome",
          "default": "Essential"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Preço",
          "default": "R$ 490"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Legenda",
          "default": "Para celebrações enxutas"
        },
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Destacar este pacote",
          "default": false
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Botão",
          "default": "Escolher pacote"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Link do botão"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Característica",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Rótulo",
          "default": "Convite impresso"
        },
        {
          "type": "text",
          "id": "v1",
          "label": "Valor — pacote 1"
        },
        {
          "type": "checkbox",
          "id": "muted1",
          "label": "Pacote 1: ausência (cor apagada)",
          "default": false
        },
        {
          "type": "text",
          "id": "v2",
          "label": "Valor — pacote 2"
        },
        {
          "type": "checkbox",
          "id": "muted2",
          "label": "Pacote 2: ausência (cor apagada)",
          "default": false
        },
        {
          "type": "text",
          "id": "v3",
          "label": "Valor — pacote 3"
        },
        {
          "type": "checkbox",
          "id": "muted3",
          "label": "Pacote 3: ausência (cor apagada)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP — Pacotes",
      "blocks": [
        {
          "type": "plan"
        },
        {
          "type": "plan"
        },
        {
          "type": "plan"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
