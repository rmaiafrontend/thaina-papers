<section class="tp-section tp-section--wine tp-quotes">
  {%- comment -%}
    Mesmo cabeçalho da faixa de trabalhos: título à esquerda, setas à direita,
    nunca por cima do conteúdo e escondidas até existir o que rolar.
  {%- endcomment -%}
  <div class="tp-section-head tp-quotes__head">
    <div class="tp-quotes__titulos">
      {%- if section.settings.heading != blank -%}
        <h2 class="tp-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="tp-quotes__sub">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
    </div>

    <div class="tp-quotes__setas" data-tp-setas hidden>
    <button type="button" class="tp-quotes__seta" data-tp-seta="-1" aria-label="Ver depoimentos anteriores">
      <span aria-hidden="true">&#8592;</span>
    </button>
      <button type="button" class="tp-quotes__seta" data-tp-seta="1" aria-label="Ver mais depoimentos">
        <span aria-hidden="true">&#8594;</span>
      </button>
    </div>
  </div>

  <div class="tp-quotes__faixa" data-tp-faixa>
    {%- for block in section.blocks -%}
      <figure class="tp-quotes__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank or block.settings.image_asset != blank -%}
          {%- render 'tp-image',
            image: block.settings.image,
            asset: block.settings.image_asset,
            alt: block.settings.author,
            class: 'tp-quotes__print',
            ratio: '2/1',
            width: 900,
            sizes: '(max-width: 899px) 84vw, 24vw',
            widths: '400,700,900'
          -%}
        {%- endif -%}
        <figcaption class="tp-quotes__corpo">
          <blockquote class="tp-quotes__text">{{ block.settings.quote }}</blockquote>
          {%- if block.settings.author != blank -%}
            <cite class="tp-quotes__author">{{ block.settings.author }}</cite>
          {%- endif -%}
        </figcaption>
      </figure>
    {%- endfor -%}
  </div>

  <script src="{{ 'tp-carrossel.js' | asset_url }}" defer></script>
</section>

{% stylesheet %}
  .tp-quotes {
    padding-block: 76px 80px;
  }

  /* O cabeçalho passou a ter duas linhas de texto, então as setas deixaram de
     ser posicionadas por cima e voltaram para o fluxo, como na faixa de
     trabalhos. O alinhamento no topo mantém a seta na altura do título, não
     no meio do bloco de dois textos. */
  .tp-quotes__head {
    align-items: flex-start;
    margin-bottom: 36px;
  }

  .tp-quotes__titulos {
    display: grid;
    gap: 6px;
  }

  .tp-quotes__sub {
    margin: 0;
    font-size: 14px;
    color: var(--tp-muted);
  }

  .tp-quotes__setas {
    display: flex;
    gap: 8px;
    flex: none;
  }

  .tp-quotes .tp-quotes__seta {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--tp-line-strong);
    background: transparent;
    color: var(--tp-ink);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
  }

  .tp-quotes .tp-quotes__seta:hover:not(:disabled) {
    border-color: var(--tp-wine);
    color: var(--tp-wine);
  }

  .tp-quotes .tp-quotes__seta:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* Mesma receita da faixa de trabalhos: sangra de borda a borda soltando o
     teto que body .tp-section > * impõe, e o recuo é o maior entre o gutter e
     a metade que sobra do container — assim o primeiro card nasce embaixo do
     chapéu da seção em qualquer largura. Sem 100vw e sem margem negativa. */
  .tp-quotes .tp-quotes__faixa {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(260px, 24vw, 380px);
    gap: 20px;
    /* stretch, não start: com todos os cards da mesma altura, o nome de cada
       pessoa pode ser ancorado na base e a linha dos nomes fica reta, mesmo
       com frases de tamanhos diferentes. */
    align-items: stretch;
    max-width: none;
    margin-inline: 0;
    padding-inline: max(var(--tp-gutter), calc((100% - var(--tp-content-width)) / 2));
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--tp-gutter), calc((100% - var(--tp-content-width)) / 2));
    scrollbar-width: none;
  }

  .tp-quotes__faixa::-webkit-scrollbar {
    display: none;
  }

  .tp-quotes__item {
    margin: 0;
    scroll-snap-align: start;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* O print é a prova; o texto abaixo é o que se lê. Um não substitui o
     outro — a imagem dá crédito, o texto dá legibilidade e acessibilidade. */
  /* 2:1 porque é a forma da bolha de conversa — larga e baixa. Numa moldura
     mais alta sobrava fundo em volta e o print parecia colado, não enquadrado. */
  .tp-quotes__print {
    aspect-ratio: 2 / 1;
    margin-bottom: 16px;
    border-radius: 10px;
  }

  .tp-quotes__corpo {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* O nome vem logo abaixo da frase. Antes ele era empurrado para a base do
     card com margin-top: auto, o que alinhava as assinaturas mas abria um vão
     grande nos depoimentos curtos — e o vão pesava mais que o alinhamento. */
  .tp-quotes__author {
    margin-top: 0;
  }

  .tp-quotes__text {
    font-family: var(--tp-serif);
    font-size: 15px;
    line-height: 1.55;
    font-weight: 500;
    margin: 0 0 8px;
  }

  .tp-quotes__author {
    font-size: 13px;
    color: var(--tp-muted);
    font-style: normal;
  }

  @media (max-width: 899px) {
    .tp-quotes {
      padding-block: 34px 36px;
    }

    .tp-quotes .tp-quotes__faixa {
      grid-auto-columns: 82%;
      gap: 12px;
    }

    .tp-quotes__text {
      font-size: 14px;
    }

    /* No celular o dedo arrasta; seta só ocuparia espaço. */
    .tp-quotes__setas {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Depoimentos",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Depoimentos"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subtítulo",
      "default": "Quem já celebrou com a gente"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Depoimento",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Print do depoimento"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Arquivo no tema (alternativa ao upload)",
          "info": "Nome do arquivo em assets/, ex.: tp-depo-ana.jpg"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Depoimento",
          "default": "Cada peça chegou exatamente como estava na prévia."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Autoria",
          "default": "Marina e Rafael · Casamento, Campina Grande"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP — Depoimentos",
      "blocks": [
        {
          "type": "quote"
        },
        {
          "type": "quote"
        },
        {
          "type": "quote"
        }
      ]
    }
  ]
}
{% endschema %}
