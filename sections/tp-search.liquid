{%- liquid
  assign filter_groups = section.blocks | where: 'type', 'filter_group'
  assign per_page = section.settings.products_per_page | default: 24
-%}

<div class="tp-busca">
  <div class="tp-busca__inner">
    <aside class="tp-busca__aside">
      <div class="tp-busca__aside-title">{{ section.settings.filters_title }}</div>

      {%- for block in filter_groups -%}
        {%- assign opts = block.settings.options | newline_to_br | split: '<br />' -%}
        <div
          class="tp-busca__group{% if forloop.last %} tp-busca__group--last{% endif %}"
          data-tp-group="{{ block.settings.key }}"
          {{ block.shopify_attributes }}
        >
          <div class="tp-busca__group-title">{{ block.settings.title }}</div>
          <div class="tp-busca__options tp-busca__options--{{ block.settings.style }}">
            {%- for raw in opts -%}
              {%- assign line = raw | strip -%}
              {%- if line == blank -%}{%- continue -%}{%- endif -%}
              {%- assign label = line | split: '|' | first | strip -%}
              {%- assign value = line | split: '|' | last | strip -%}
              {%- assign fid = 'f-' | append: block.id | append: '-' | append: forloop.index -%}
              <input
                type="checkbox"
                class="tp-busca__opt-input"
                id="{{ fid }}"
                data-tp-filter
                data-group="{{ block.settings.key }}"
                data-value="{{ value }}"
              >
              <label class="tp-busca__opt tp-busca__opt--{{ block.settings.style }}" for="{{ fid }}">
                {%- if block.settings.style == 'checkbox' -%}
                  <span class="tp-busca__box" aria-hidden="true"></span>
                {%- endif -%}
                <span class="tp-busca__opt-label">{{ label }}</span>
              </label>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </aside>

    <div class="tp-busca__main">
      <form action="{{ routes.search_url }}" method="get" role="search" class="tp-busca__form">
        <label class="visually-hidden" for="tp-busca-q">{{ section.settings.search_label }}</label>
        <input
          id="tp-busca-q"
          type="search"
          name="q"
          class="tp-busca__field"
          placeholder="{{ section.settings.search_placeholder }}"
          value="{{ search.terms | escape }}"
          autofocus
        >
        <button type="submit" class="tp-btn tp-btn--solid tp-busca__submit">
          {{- section.settings.search_label -}}
        </button>
      </form>

      <div class="tp-busca__head">
        <h1 class="tp-busca__title">
          {%- if search.terms != blank -%}
            {{ section.settings.results_prefix }} &ldquo;{{ search.terms }}&rdquo;
          {%- else -%}
            {{ section.settings.empty_terms_title }}
          {%- endif -%}
        </h1>
        <div class="tp-busca__meta">
          <span data-tp-count>{{ search.results_count }}</span>
          <span data-tp-count-word>{% if search.results_count == 1 %}produto{% else %}produtos{% endif %}</span>
          <span aria-hidden="true"> · </span>
          <label class="visually-hidden" for="tp-busca-sort">{{ section.settings.sort_label }}</label>
          <select id="tp-busca-sort" class="tp-busca__sort" data-tp-sort>
            {%- assign current_sort = search.sort_by | default: 'relevance' -%}
            <option value="relevance" {% if current_sort == 'relevance' %}selected{% endif %}>ordenar por relevância</option>
            <option value="price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>ordenar por menor preço</option>
            <option value="price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>ordenar por maior preço</option>
            <option value="title-ascending" {% if current_sort == 'title-ascending' %}selected{% endif %}>ordenar por nome</option>
          </select>
        </div>
      </div>

      <div class="tp-busca__chips" data-tp-chips hidden>
        <div class="tp-busca__chips-list" data-tp-chips-list></div>
        <button type="button" class="tp-busca__clear button-unstyled" data-tp-clear>{{ section.settings.clear_label }}</button>
      </div>

      {%- paginate search.results by per_page -%}
        {%- assign products = search.results | where: 'object_type', 'product' -%}

        {%- if products.size > 0 -%}
          <div class="tp-busca__grid" data-tp-grid>
            {%- for product in products -%}
              {%- liquid
                assign delivery = 'fisico'
                assign badge = 'Produto físico'
                if product.tags contains 'template-canva'
                  assign delivery = 'template-canva'
                  assign badge = 'Template Canva'
                elsif product.tags contains 'arte-digital'
                  assign delivery = 'arte-digital'
                  assign badge = 'Arte digital'
                elsif product.tags contains 'arquivo-digital'
                  assign delivery = 'arquivo-digital'
                  assign badge = 'Arquivo digital'
                elsif product.requires_shipping == false
                  assign delivery = 'arquivo-digital'
                  assign badge = 'Arquivo digital'
                endif

                assign occasion = ''
                if product.tags contains 'casamentos'
                  assign occasion = 'casamentos'
                elsif product.tags contains 'formaturas'
                  assign occasion = 'formaturas'
                elsif product.tags contains 'consultorios'
                  assign occasion = 'consultorios'
                endif

                assign qty = ''
                assign fmt = ''
                for tag in product.tags
                  if tag contains 'qtd-'
                    assign qty = tag | remove: 'qtd-'
                  endif
                  if tag contains 'formato-'
                    assign fmt = tag | remove: 'formato-'
                  endif
                endfor
              -%}
              <div
                class="tp-busca__card"
                data-tp-card
                data-delivery="{{ delivery }}"
                data-occasion="{{ occasion }}"
                data-qty="{{ qty }}"
                data-format="{{ fmt }}"
                data-price="{{ product.price }}"
              >
                <a href="{{ product.url }}" class="tp-busca__card-media-link">
                  <div class="tp-media tp-busca__card-media">
                    {%- if product.featured_image -%}
                      {{
                        product.featured_image
                        | image_url: width: 700
                        | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 45vw, 28vw', widths: '300,500,700'
                      }}
                    {%- else -%}
                      <div class="tp-media__placeholder">{{ product.title }}</div>
                    {%- endif -%}
                    <div class="tp-busca__badge{% if delivery != 'fisico' %} tp-busca__badge--accent{% endif %}">{{ badge }}</div>
                  </div>
                </a>
                <div class="tp-busca__card-body">
                  <a href="{{ product.url }}" class="tp-busca__card-title">{{ product.title }}</a>
                  {%- if product.type != blank -%}
                    <div class="tp-busca__card-meta">{{ product.type }}</div>
                  {%- endif -%}
                  <div class="tp-busca__card-price">{{ product.price | money }}</div>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <p class="tp-busca__none" data-tp-none hidden>{{ section.settings.no_filter_match }}</p>

          {%- if paginate.pages > 1 -%}
            <div class="tp-busca__pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="tp-busca__page-link">&larr; {{ section.settings.prev_label }}</a>
              {%- endif -%}
              <span class="tp-busca__page-count">{{ paginate.current_page }} / {{ paginate.pages }}</span>
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="tp-busca__page-link">{{ section.settings.next_label }} &rarr;</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <p class="tp-busca__none">{{ section.settings.empty_results }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('.tp-busca');
    if (!root) return;

    var inputs = Array.prototype.slice.call(root.querySelectorAll('[data-tp-filter]'));
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-tp-card]'));
    var countEl = root.querySelector('[data-tp-count]');
    var wordEl = root.querySelector('[data-tp-count-word]');
    var chipsWrap = root.querySelector('[data-tp-chips]');
    var chipsList = root.querySelector('[data-tp-chips-list]');
    var clearBtn = root.querySelector('[data-tp-clear]');
    var noneEl = root.querySelector('[data-tp-none]');
    var sortEl = root.querySelector('[data-tp-sort]');

    function selected() {
      var byGroup = {};
      inputs.forEach(function (i) {
        if (!i.checked) return;
        (byGroup[i.dataset.group] = byGroup[i.dataset.group] || []).push(i.dataset.value);
      });
      return byGroup;
    }

    // Faixa de preço vem como "min-max" em centavos; "40000-" significa sem teto.
    function priceMatches(price, ranges) {
      return ranges.some(function (r) {
        var parts = r.split('-');
        var min = parseInt(parts[0], 10) || 0;
        var max = parts[1] === '' || parts[1] === undefined ? Infinity : parseInt(parts[1], 10);
        return price >= min && price <= max;
      });
    }

    function apply() {
      var sel = selected();
      var groups = Object.keys(sel);
      var visible = 0;

      cards.forEach(function (card) {
        var ok = groups.every(function (g) {
          var values = sel[g];
          if (g === 'price') return priceMatches(parseInt(card.dataset.price, 10) || 0, values);
          return values.indexOf(card.dataset[g] || '') !== -1;
        });
        card.hidden = !ok;
        if (ok) visible++;
      });

      if (countEl) countEl.textContent = visible;
      if (wordEl) wordEl.textContent = visible === 1 ? 'produto' : 'produtos';
      if (noneEl) noneEl.hidden = visible !== 0;

      var active = inputs.filter(function (i) { return i.checked; });
      if (chipsWrap) chipsWrap.hidden = active.length === 0;
      if (chipsList) {
        chipsList.innerHTML = '';
        active.forEach(function (i) {
          var label = root.querySelector('label[for="' + i.id + '"] .tp-busca__opt-label');
          var chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'tp-busca__chip';
          chip.textContent = (label ? label.textContent.trim() : i.dataset.value) + ' ×';
          chip.addEventListener('click', function () { i.checked = false; apply(); });
          chipsList.appendChild(chip);
        });
      }
    }

    inputs.forEach(function (i) { i.addEventListener('change', apply); });
    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        inputs.forEach(function (i) { i.checked = false; });
        apply();
      });
    }

    // A ordenação é do servidor: recarrega mantendo o termo buscado.
    if (sortEl) {
      sortEl.addEventListener('change', function () {
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', sortEl.value);
        window.location.href = url.toString();
      });
    }

    apply();
  })();
</script>

{% stylesheet %}
  .tp-busca {
    font-family: var(--tp-sans);
    color: var(--tp-ink);
    background: var(--tp-cream);
  }

  .tp-busca * {
    box-sizing: border-box;
  }

  .tp-busca a {
    color: inherit;
    text-decoration: none;
  }

  .tp-busca__inner {
    display: flex;
    gap: 48px;
    align-items: flex-start;
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding-block: 48px 64px;
    padding-inline: var(--tp-gutter);
  }

  .tp-busca__aside {
    width: 280px;
    flex: none;
  }

  .tp-busca__aside-title {
    font-family: var(--tp-serif);
    font-size: 24px;
    font-weight: 500;
    margin-bottom: 22px;
  }

  .tp-busca__group {
    border-top: 1px solid var(--tp-line);
    padding-block: 18px;
  }

  .tp-busca__group--last {
    border-bottom: 1px solid var(--tp-line);
  }

  .tp-busca__group-title {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-wine);
    margin-bottom: 12px;
  }

  .tp-busca__options--checkbox {
    display: grid;
    gap: 10px;
    font-size: 14px;
  }

  .tp-busca__options--pill {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tp-busca__opt-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .tp-busca__opt--checkbox {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }

  .tp-busca__box {
    width: 15px;
    height: 15px;
    flex: none;
    border: 1px solid rgba(36, 33, 31, 0.4);
  }

  .tp-busca__opt-input:checked + .tp-busca__opt--checkbox .tp-busca__box {
    border-color: var(--tp-ink);
    background: var(--tp-ink);
  }

  .tp-busca__opt--pill {
    display: flex;
    align-items: center;
    height: 32px;
    padding-inline: 12px;
    border: 1px solid rgba(36, 33, 31, 0.28);
    font-size: 13px;
    cursor: pointer;
  }

  .tp-busca__opt-input:checked + .tp-busca__opt--pill {
    border-color: var(--tp-ink);
    background: var(--tp-ink);
    color: var(--tp-cream);
  }

  .tp-busca__opt-input:focus-visible + .tp-busca__opt {
    outline: 2px solid var(--tp-wine);
    outline-offset: 2px;
  }

  .tp-busca__main {
    flex: 1;
    min-width: 0;
  }

  .tp-busca .tp-btn--solid {
    background: var(--tp-wine);
    color: var(--tp-cream);
  }

  .tp-busca__form {
    display: flex;
    gap: 10px;
    margin-bottom: 26px;
  }

  .tp-busca__field {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding-inline: 16px;
    border: 1px solid rgba(36, 33, 31, 0.28);
    border-radius: 0;
    background: var(--tp-cream);
    font-family: var(--tp-sans);
    font-size: 15px;
    color: var(--tp-ink);
  }

  .tp-busca__field:focus-visible {
    outline: 2px solid var(--tp-wine);
    outline-offset: -1px;
  }

  .tp-busca__submit {
    flex: none;
    height: 48px;
    padding-inline: 26px;
    font-size: 14px;
    border: none;
    font-family: var(--tp-sans);
    cursor: pointer;
  }

  .tp-busca__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .tp-busca__title {
    font-family: var(--tp-serif);
    font-weight: 500;
    font-size: 34px;
    margin: 0;
  }

  .tp-busca__meta {
    font-size: 13px;
    color: var(--tp-muted);
    flex: none;
  }

  .tp-busca__sort {
    font-family: var(--tp-sans);
    font-size: 13px;
    color: var(--tp-muted);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .tp-busca__chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    margin-block: 18px 26px;
  }

  .tp-busca__chips[hidden] {
    display: none;
  }

  .tp-busca__chips-list {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tp-busca__chip {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding-inline: 14px;
    background: var(--tp-ink);
    color: var(--tp-cream);
    font-size: 13px;
    font-family: var(--tp-sans);
    border: none;
    cursor: pointer;
  }

  .tp-busca__clear {
    display: flex;
    align-items: center;
    height: 34px;
    font-size: 13px;
    font-family: var(--tp-sans);
    color: var(--tp-wine);
    cursor: pointer;
  }

  .tp-busca__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .tp-busca__card[hidden] {
    display: none;
  }

  .tp-busca__card-media-link {
    position: relative;
    display: block;
  }

  .tp-busca__card-media {
    height: 280px;
    border-radius: 18px;
  }

  .tp-busca__badge {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 6px 12px;
    background: rgba(36, 33, 31, 0.72);
    color: var(--tp-cream);
    font-size: 12px;
    border-radius: 999px;
    pointer-events: none;
  }

  .tp-busca__badge--accent {
    background: rgba(93, 14, 9, 0.9);
  }

  .tp-busca__card-body {
    padding-top: 12px;
  }

  .tp-busca__card-title {
    display: block;
    font-size: 15px;
  }

  .tp-busca__card-meta {
    font-size: 13px;
    color: var(--tp-muted);
    margin-top: 3px;
  }

  .tp-busca__card-price {
    font-size: 16px;
    font-weight: 500;
    margin-top: 8px;
  }

  .tp-busca__none {
    font-size: 15px;
    color: var(--tp-muted);
    margin-block: 24px 0;
  }

  .tp-busca__none[hidden] {
    display: none;
  }

  .tp-busca__pagination {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 36px;
    font-size: 14px;
  }

  .tp-busca__page-link {
    color: var(--tp-wine);
    font-weight: 500;
  }

  .tp-busca__page-count {
    color: var(--tp-muted);
  }

  @media (max-width: 1100px) {
    .tp-busca__inner {
      gap: 32px;
    }

    .tp-busca__aside {
      width: 230px;
    }

    .tp-busca__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 899px) {
    .tp-busca__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
      padding-block: 28px 40px;
    }

    .tp-busca__aside {
      width: auto;
    }

    .tp-busca__title {
      font-size: 26px;
    }

    .tp-busca__head {
      gap: 8px;
    }

    .tp-busca__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .tp-busca__card-media {
      height: 200px;
      border-radius: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Busca",
  "settings": [
    {
      "type": "text",
      "id": "filters_title",
      "label": "Título da barra de filtros",
      "default": "Filtrar"
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Botão de busca",
      "default": "Buscar"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder do campo",
      "default": "O que você está procurando?"
    },
    {
      "type": "text",
      "id": "results_prefix",
      "label": "Prefixo do título de resultados",
      "default": "Resultados para"
    },
    {
      "type": "text",
      "id": "empty_terms_title",
      "label": "Título sem termo buscado",
      "default": "Buscar no catálogo"
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Rótulo acessível da ordenação",
      "default": "Ordenar resultados"
    },
    {
      "type": "text",
      "id": "clear_label",
      "label": "Limpar filtros",
      "default": "Limpar filtros"
    },
    {
      "type": "text",
      "id": "no_filter_match",
      "label": "Nenhum resultado após filtrar",
      "default": "Nenhum produto corresponde aos filtros selecionados."
    },
    {
      "type": "text",
      "id": "empty_results",
      "label": "Busca sem resultados",
      "default": "Nenhum produto encontrado para essa busca."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Produtos por página",
      "min": 6,
      "max": 48,
      "step": 6,
      "default": 24
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Página anterior",
      "default": "Anteriores"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Próxima página",
      "default": "Próximos"
    }
  ],
  "blocks": [
    {
      "type": "filter_group",
      "name": "Grupo de filtro",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Tipo de entrega"
        },
        {
          "type": "select",
          "id": "key",
          "label": "Filtra por",
          "options": [
            { "value": "delivery", "label": "Tipo de entrega" },
            { "value": "occasion", "label": "Ocasião" },
            { "value": "qty", "label": "Quantidade" },
            { "value": "format", "label": "Formato" },
            { "value": "price", "label": "Faixa de preço" }
          ],
          "default": "delivery"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Estilo",
          "options": [
            { "value": "checkbox", "label": "Caixas de seleção" },
            { "value": "pill", "label": "Pastilhas" }
          ],
          "default": "checkbox"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "Opções (uma por linha: Texto | valor)",
          "info": "Para faixa de preço, o valor é min-max em centavos (ex.: 5000-15000; 40000- para sem teto).",
          "default": "Produto físico | fisico\nArquivo digital para impressão | arquivo-digital\nArte digital pronta | arte-digital\nTemplate Canva | template-canva"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP — Busca",
      "blocks": [
        { "type": "filter_group" }
      ]
    }
  ]
}
{% endschema %}
