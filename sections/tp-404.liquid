<section class="tp-section tp-404">
  <div class="tp-404__inner">
    <div class="tp-404__lead-col">
      <div class="tp-404__eyebrow">{{ section.settings.eyebrow }}</div>
      <h1 class="tp-404__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="tp-404__text">{{ section.settings.text }}</p>
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" role="search" class="tp-404__form">
        <label class="visually-hidden" for="tp-404-q">{{ section.settings.search_label }}</label>
        <input
          id="tp-404-q"
          type="search"
          name="q"
          class="tp-404__field"
          placeholder="{{ section.settings.search_placeholder }}"
        >
        <button type="submit" class="tp-btn tp-btn--solid tp-404__submit">
          {{- section.settings.search_label -}}
        </button>
      </form>
    </div>

    {%- if section.blocks.size > 0 -%}
      <nav class="tp-404__links" aria-label="{{ section.settings.links_title }}">
        <div class="tp-404__links-title">{{ section.settings.links_title }}</div>
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }}>
            <span>{{ block.settings.label }}</span>
            {%- if block.settings.note != blank -%}
              <small>{{ block.settings.note }}</small>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .tp-404 {
    padding-block: 72px 88px;
  }

  .tp-404 * {
    box-sizing: border-box;
  }

  .tp-404__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 72px;
    align-items: start;
  }

  .tp-404__eyebrow {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tp-wine);
    margin-bottom: 18px;
  }

  .tp-404__title {
    font-family: var(--tp-serif);
    font-weight: 500;
    font-size: clamp(38px, 5.6vw, 68px);
    line-height: 1.08;
    color: var(--tp-ink);
    margin: 0 0 18px;
    max-width: 12ch;
  }

  .tp-404__text {
    font-size: 16px;
    line-height: 1.65;
    color: var(--tp-body);
    margin: 0 0 32px;
    max-width: 46ch;
  }

  .tp-404__form {
    display: flex;
    gap: 10px;
    max-width: 520px;
  }

  .tp-404 .tp-404__field {
    flex: 1;
    min-width: 0;
    height: 50px;
    padding: 0 16px;
    border: 1px solid var(--tp-line-strong);
    background: var(--tp-cream);
    font-family: var(--tp-sans);
    font-size: 15px;
    color: var(--tp-ink);
  }

  .tp-404__field::placeholder {
    color: var(--tp-muted);
  }

  .tp-404__submit {
    flex: none;
    background: var(--tp-wine);
    color: var(--tp-cream);
  }

  /* A coluna de atalhos existe porque numa 404 o que resolve é sair dela. */
  .tp-404__links {
    border-top: 1px solid var(--tp-line-strong);
    padding-top: 18px;
  }

  .tp-404__links-title {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tp-muted);
    margin-bottom: 6px;
  }

  .tp-404__links a {
    display: block;
    padding-block: 14px;
    border-bottom: 1px solid var(--tp-line-soft);
    color: var(--tp-ink);
    text-decoration: none;
  }

  .tp-404__links a:hover {
    color: var(--tp-wine);
  }

  .tp-404__links a span {
    display: block;
    font-size: 16px;
  }

  .tp-404__links a small {
    display: block;
    font-size: 13px;
    line-height: 1.5;
    color: var(--tp-muted);
    margin-top: 3px;
  }

  @media (max-width: 999px) {
    .tp-404__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
    }
  }

  @media (max-width: 749px) {
    .tp-404 {
      padding-block: 40px 56px;
    }

    .tp-404__form {
      flex-direction: column;
    }

    .tp-404__submit {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — 404",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Erro 404" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Esta página não está no papel." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "O endereço que você abriu não existe ou mudou de lugar. Busque pelo que procurava ou comece por um destes caminhos."
    },
    { "type": "text", "id": "search_label", "label": "Botão da busca", "default": "Buscar" },
    { "type": "text", "id": "search_placeholder", "label": "Placeholder da busca", "default": "Convite, save the date, template..." },
    { "type": "text", "id": "links_title", "label": "Título dos atalhos", "default": "Ir para" }
  ],
  "blocks": [
    {
      "type": "shortcut",
      "name": "Atalho",
      "settings": [
        { "type": "text", "id": "label", "label": "Nome", "default": "Início" },
        { "type": "text", "id": "note", "label": "Descrição" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP — 404",
      "blocks": [
        { "type": "shortcut" },
        { "type": "shortcut" },
        { "type": "shortcut" },
        { "type": "shortcut" }
      ]
    }
  ]
}
{% endschema %}
