    { "type": "text", "id": "image_1_alt", "label": "Descrição", "default": "Monograma recortado em dourado sobre o bolo" },

    { "type": "image_picker", "id": "image_2", "label": "2 · cima, direita" },
    { "type": "text", "id": "image_2_asset", "label": "Arquivo no tema", "default": "tp-trabalho-convite.jpg" },
    { "type": "text", "id": "image_2_alt", "label": "Descrição", "default": "Convite de casamento em caixa com laço" },

    { "type": "image_picker", "id": "image_3", "label": "3 · baixo, larga" },
    { "type": "text", "id": "image_3_asset", "label": "Arquivo no tema", "default": "tp-trabalho-mesa.jpg" },
    { "type": "text", "id": "image_3_alt", "label": "Descrição", "default": "Mesa posta de formatura, com menu e marcador de lugar" },

    { "type": "image_picker", "id": "image_4", "label": "4 · baixo, quadrada" },
    { "type": "text", "id": "image_4_asset", "label": "Arquivo no tema", "default": "tp-trabalho-batizado.jpg" },
    { "type": "text", "id": "image_4_alt", "label": "Descrição", "default": "Prato de porcelana pintado à mão para batizado" },

    { "type": "image_picker", "id": "image_5", "label": "5 · baixo, direita" },
    { "type": "text", "id": "image_5_asset", "label": "Arquivo no tema", "default": "tp-trabalho-mesa-posta.jpg" },
    { "type": "text", "id": "image_5_alt", "label": "Descrição", "default": "Guardanapo com monograma bordado sobre sousplat" }
  ],
  "blocks": [
    {
      "type": "prova",
      "name": "Argumento",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Pequenos lotes" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Nada é impresso antes de existir uma celebração." }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP — Hero mosaico",
      "blocks": [{ "type": "prova" }, { "type": "prova" }, { "type": "prova" }]
    }
  ]
}
{% endschema %}
