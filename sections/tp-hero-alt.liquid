{%- comment -%}
  Segunda versão do hero: mosaico de revista sobre faixa azul.

  A diferença para a abertura atual não é a cor, é a estrutura. Lá o texto é
  uma coluna ao lado de uma foto. Aqui o texto é uma CÉLULA da grade, cercada
  pelas fotos em cima, embaixo e dos lados — a página lê como capa de revista
  em vez de duas colunas.

  As células têm larguras diferentes de propósito. Uma grade regular de seis
  fotos viraria tabela; a assimetria é o que dá ritmo sem inclinar nada, que
  brigaria com o desenho reto do tema.
{%- endcomment -%}

{%- liquid
  assign provas = section.blocks | where: 'type', 'prova'
-%}

<section class="tp-section tp-section--blue tp-mosaico">
  <div class="tp-mosaico__grade">
    <figure class="tp-mosaico__cel tp-mosaico__cel--a">
      {%- render 'tp-image',
        image: section.settings.image_1,
        asset: section.settings.image_1_asset,
        alt: section.settings.image_1_alt,
        class: 'tp-mosaico__foto',
        ratio: '2/3',
        width: 700,
        sizes: '(max-width: 899px) 50vw, 24vw',
        widths: '300,500,700',
        loading: 'eager'
      -%}
    </figure>

    <div class="tp-mosaico__cel tp-mosaico__cel--texto">
      {%- if section.settings.script_text != blank -%}
        <div class="tp-mosaico__script">{{ section.settings.script_text }}</div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="tp-mosaico__titulo">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.lead != blank -%}
        <p class="tp-mosaico__lead">{{ section.settings.lead }}</p>
      {%- endif -%}

      <div class="tp-mosaico__acoes">
        {%- if section.settings.button_1_label != blank -%}
          <a
            {% if section.settings.button_1_link != blank %}href="{{ section.settings.button_1_link }}"{% endif %}
            class="tp-btn tp-btn--solid"
          >
            {{- section.settings.button_1_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a
            {% if section.settings.button_2_link != blank %}href="{{ section.settings.button_2_link }}"{% endif %}
            class="tp-btn tp-btn--outline tp-mosaico__btn-vazado"
          >
            {{- section.settings.button_2_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <figure class="tp-mosaico__cel tp-mosaico__cel--b">
      {%- render 'tp-image',
        image: section.settings.image_2,
        asset: section.settings.image_2_asset,
        alt: section.settings.image_2_alt,
        class: 'tp-mosaico__foto',
        ratio: '2/3',
        width: 700,
        sizes: '(max-width: 899px) 50vw, 24vw',
        widths: '300,500,700',
        loading: 'eager'
      -%}
    </figure>

    <figure class="tp-mosaico__cel tp-mosaico__cel--c">
      {%- render 'tp-image',
        image: section.settings.image_3,
        asset: section.settings.image_3_asset,
        alt: section.settings.image_3_alt,
        class: 'tp-mosaico__foto',
        ratio: '3/2',
        width: 900,
        sizes: '(max-width: 899px) 50vw, 34vw',
        widths: '400,700,900'
      -%}
    </figure>

    <figure class="tp-mosaico__cel tp-mosaico__cel--d">
      {%- render 'tp-image',
        image: section.settings.image_4,
        asset: section.settings.image_4_asset,
        alt: section.settings.image_4_alt,
        class: 'tp-mosaico__foto',
        ratio: '1/1',
        width: 600,
        sizes: '(max-width: 899px) 50vw, 20vw',
        widths: '300,500,600'
      -%}
    </figure>

    <figure class="tp-mosaico__cel tp-mosaico__cel--e">
      {%- render 'tp-image',
        image: section.settings.image_5,
        asset: section.settings.image_5_asset,
        alt: section.settings.image_5_alt,
        class: 'tp-mosaico__foto',
        ratio: '3/2',
        width: 900,
        sizes: '(max-width: 899px) 50vw, 30vw',
        widths: '400,700,900'
      -%}
    </figure>
  </div>

  {%- if provas.size > 0 -%}
    <div class="tp-mosaico__provas">
      {%- for block in provas -%}
        <div class="tp-mosaico__prova" {{ block.shopify_attributes }}>
          <span class="tp-mosaico__prova-titulo">{{ block.settings.title }}</span>
          {%- if block.settings.text != blank -%}
            <span class="tp-mosaico__prova-texto">{{ block.settings.text }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .tp-mosaico {
    padding-block: 40px 0;
  }

  /* Doze colunas para poder quebrar em 3/6/3 e 5/3/4 — números que não se
     repetem entre as duas fileiras, que é de onde vem a assimetria. */
  .tp-mosaico__grade {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: min-content;
    gap: 14px;
  }

  .tp-mosaico__cel {
    margin: 0;
    min-width: 0;
  }

  .tp-mosaico__cel--a { grid-column: 1 / span 3; grid-row: 1; }
  .tp-mosaico__cel--texto { grid-column: 4 / span 6; grid-row: 1; }
  .tp-mosaico__cel--b { grid-column: 10 / span 3; grid-row: 1; }
  .tp-mosaico__cel--c { grid-column: 1 / span 5; grid-row: 2; }
  .tp-mosaico__cel--d { grid-column: 6 / span 3; grid-row: 2; }
  .tp-mosaico__cel--e { grid-column: 9 / span 4; grid-row: 2; }

  /* ---------- célula de texto ---------- */

  .tp-mosaico__cel--texto {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 20px 24px;
  }

  .tp-mosaico__script {
    font-family: var(--tp-script);
    font-size: 30px;
    line-height: 1;
    color: var(--tp-wine);
    margin-bottom: 6px;
  }

  .tp-mosaico__titulo {
    font-family: var(--tp-serif);
    font-weight: 400;
    font-size: clamp(40px, 4.6vw, 64px);
    line-height: 1.02;
    color: var(--tp-ink);
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .tp-mosaico__lead {
    font-family: var(--tp-serif);
    font-size: 17px;
    line-height: 1.5;
    color: var(--tp-ink);
    margin: 0 0 22px;
    max-width: 34ch;
  }

  .tp-mosaico__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .tp-mosaico .tp-mosaico__btn-vazado {
    border-color: var(--tp-ink);
    color: var(--tp-ink);
  }

  .tp-mosaico .tp-mosaico__btn-vazado:hover {
    background: var(--tp-ink);
    color: var(--tp-blue);
  }

  /* ---------- fotos ---------- */

  /* Cada célula pede um formato: as da fileira de cima são retratos altos,
     as de baixo são deitadas e uma quadrada. É a variação de forma, mais que
     a de tamanho, que faz o conjunto parecer mosaico e não galeria. */
  .tp-mosaico__cel--a .tp-mosaico__foto,
  .tp-mosaico__cel--b .tp-mosaico__foto { aspect-ratio: 2 / 3; }
  .tp-mosaico__cel--c .tp-mosaico__foto,
  .tp-mosaico__cel--e .tp-mosaico__foto { aspect-ratio: 3 / 2; }
  .tp-mosaico__cel--d .tp-mosaico__foto { aspect-ratio: 1 / 1; }

  /* ---------- tira de argumentos ---------- */

  .tp-mosaico__provas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 44px;
    border-top: 1px solid rgba(61, 39, 34, 0.22);
  }

  .tp-mosaico__prova {
    display: grid;
    gap: 4px;
    padding: 20px 28px 24px 0;
  }

  .tp-mosaico__prova + .tp-mosaico__prova {
    padding-left: 28px;
    border-left: 1px solid rgba(61, 39, 34, 0.22);
  }

  .tp-mosaico__prova-titulo {
    font-family: var(--tp-serif);
    font-size: 17px;
    font-weight: 500;
    color: var(--tp-ink);
  }

  .tp-mosaico__prova-texto {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--tp-body);
  }

  @media (max-width: 1100px) {
    .tp-mosaico__grade { gap: 10px; }
    .tp-mosaico__cel--texto { padding: 12px 8px; }
  }

  @media (max-width: 899px) {
    .tp-mosaico {
      padding-block: 26px 0;
    }

    /* No celular o mosaico vira duas colunas: o texto ocupa a largura toda em
       cima e as fotos se acomodam abaixo, aos pares. Manter seis células numa
       tela estreita deixaria cada foto do tamanho de um selo. */
    .tp-mosaico__grade {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    /* order: -1 põe o texto na frente de tudo. Sem isso ele fica na posição
       do código, no meio da grade, e cada foto vizinha sobra sozinha na sua
       linha — a coluna ao lado fica em branco. */
    .tp-mosaico__cel--texto {
      order: -1;
      grid-column: 1 / -1;
      grid-row: auto;
      padding: 8px 0 18px;
    }

    .tp-mosaico__cel--a,
    .tp-mosaico__cel--b,
    .tp-mosaico__cel--c,
    .tp-mosaico__cel--d,
    .tp-mosaico__cel--e {
      grid-column: auto;
      grid-row: auto;
    }

    /* A larga atravessa as duas colunas para o conjunto não virar uma grade
       de quatro iguais. */
    .tp-mosaico__cel--c {
      grid-column: 1 / -1;
    }

    .tp-mosaico__script { font-size: 26px; }

    .tp-mosaico__provas {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 28px;
    }

    .tp-mosaico__prova {
      padding: 14px 0 16px;
    }

    .tp-mosaico__prova + .tp-mosaico__prova {
      padding-left: 0;
      border-left: none;
      border-top: 1px solid rgba(61, 39, 34, 0.18);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Hero mosaico",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "script_text",
      "label": "Manuscrito",
      "default": "feito à mão"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Não é só papel"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Frase de abertura",
      "default": "É a primeira parte da história que chega às mãos de quem você escolheu para vivê-la com você."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Botão principal",
      "default": "Ver todos os produtos"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Destino do botão principal"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Botão secundário",
      "default": "Sob medida"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Destino do botão secundário"
    },
    {
      "type": "header",
      "content": "Fotos do mosaico",
      "info": "Cinco células. As duas de cima são retratos altos; embaixo, duas deitadas e uma quadrada."
    },
    { "type": "image_picker", "id": "image_1", "label": "1 · cima, esquerda" },
