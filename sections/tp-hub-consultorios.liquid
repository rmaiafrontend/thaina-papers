{%- liquid
  assign kit_blocks = section.blocks | where: 'type', 'kit'
  assign cartela_blocks = section.blocks | where: 'type', 'cartela'
  assign soon_blocks = section.blocks | where: 'type', 'em_breve'

  # Sem imagem de verdade o hero reservava metade da tela para um retângulo
  # cinza. Resolvendo a fonte antes, a seção decide se a coluna existe.
  assign hero_image = section.settings.hero_image | default: collection.image
-%}

<div class="tp-hub-consultorios">
  <div class="tp-hub-consultorios__intro{% unless hero_image %} tp-hub-consultorios__intro--sem-imagem{% endunless %}">
    <div class="tp-hub-consultorios__col">
      <div class="tp-hub-consultorios__breadcrumb">
        <a href="{{ routes.root_url }}">Início</a>
        <span aria-hidden="true"> / </span>
        <span>{{ section.settings.breadcrumb_label | default: collection.title }}</span>
      </div>
      <h1 class="tp-hub-consultorios__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.description != blank -%}
        <div class="tp-hub-consultorios__lead">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>
    {%- if hero_image -%}
      <div class="tp-media tp-hub-consultorios__hero-media">
        {{
          hero_image
          | image_url: width: 900
          | image_tag: loading: 'eager', sizes: '(max-width: 899px) 100vw, 40vw', widths: '400,650,900'
        }}
      </div>
    {%- endif -%}
  </div>

  <div class="tp-hub-consultorios__notice-wrap">
    <div class="tp-hub-consultorios__notice">
      <div class="tp-hub-consultorios__notice-label">{{ section.settings.notice_label }}</div>
      {%- if section.settings.notice_text != blank -%}
        <div class="tp-hub-consultorios__notice-text">{{ section.settings.notice_text }}</div>
      {%- endif -%}
    </div>
  </div>

  <div class="tp-hub-consultorios__catalog">
    {%- if kit_blocks.size > 0 -%}
      <div class="tp-hub-consultorios__kits-head">
        <div class="tp-hub-consultorios__section-title">{{ section.settings.kits_heading }}</div>
        <div class="tp-hub-consultorios__section-note">{{ section.settings.kits_note }}</div>
      </div>
      <div class="tp-hub-consultorios__kits-grid">
        {%- for block in kit_blocks -%}
          <div class="tp-hub-consultorios__kit" {{ block.shopify_attributes }}>
            <div class="tp-media tp-hub-consultorios__kit-media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 320
                  | image_tag: loading: 'lazy', sizes: '160px', widths: '160,240,320'
                }}
              {%- else -%}
                <div class="tp-media__placeholder">{{ block.settings.title }}</div>
              {%- endif -%}
            </div>
            <div class="tp-hub-consultorios__kit-body">
              <div class="tp-hub-consultorios__kit-title">{{ block.settings.title }}</div>
              {%- if block.settings.description != blank -%}
                <p class="tp-hub-consultorios__kit-text">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.price != blank -%}
                <div class="tp-hub-consultorios__kit-price">{{ block.settings.price }}</div>
              {%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <a href="{{ block.settings.link | default: '#' }}" class="tp-hub-consultorios__kit-link">{{ block.settings.link_label }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if cartela_blocks.size > 0 -%}
      <div class="tp-hub-consultorios__cartelas-head">
        <div class="tp-hub-consultorios__section-title">{{ section.settings.cartelas_heading }}</div>
        <div class="tp-hub-consultorios__section-note">{{ section.settings.cartelas_note }}</div>
      </div>
      <div class="tp-hub-consultorios__cartelas-grid">
        {%- for block in cartela_blocks -%}
          <div class="tp-hub-consultorios__cartela" {{ block.shopify_attributes }}>
            <div class="tp-media tp-hub-consultorios__cartela-media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 45vw, 22vw', widths: '300,450,600'
                }}
              {%- else -%}
                <div class="tp-media__placeholder">{{ block.settings.title }}</div>
              {%- endif -%}
            </div>
            <div class="tp-hub-consultorios__cartela-body">
              <div class="tp-hub-consultorios__cartela-title">{{ block.settings.title }}</div>
              {%- if block.settings.price != blank -%}
                <div class="tp-hub-consultorios__cartela-price">{{ block.settings.price }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if soon_blocks.size > 0 -%}
      <div class="tp-hub-consultorios__soon-grid">
        {%- for block in soon_blocks -%}
          <div class="tp-hub-consultorios__soon" {{ block.shopify_attributes }}>
            {%- if block.settings.eyebrow != blank -%}
              <div class="tp-hub-consultorios__soon-eyebrow">{{ block.settings.eyebrow }}</div>
            {%- endif -%}
            <div class="tp-hub-consultorios__soon-title">{{ block.settings.title }}</div>
            {%- if block.settings.description != blank -%}
              <p class="tp-hub-consultorios__soon-text">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a href="{{ block.settings.link | default: '#' }}" class="tp-hub-consultorios__soon-link">{{ block.settings.link_label }}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .tp-hub-consultorios {
    font-family: var(--tp-sans);
    color: var(--tp-ink);
    background: var(--tp-cream);
  }

  .tp-hub-consultorios * {
    box-sizing: border-box;
  }

  .tp-hub-consultorios a {
    color: inherit;
    text-decoration: none;
  }

  /* O flex dava ao texto uma coluna de 760px com o conteúdo travado em
     620px, e encostava uma caixa fixa de 420px na direita — sobrava um vão
     morto no meio. Agora são duas frações do grid de 12: o texto ocupa a
     sua inteira e a foto acompanha a largura em vez de ter tamanho fixo. */
  .tp-hub-consultorios__intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    /* Centrado, e não pelo rodapé: o texto varia de duas a seis linhas
       entre as páginas, e travá-lo embaixo abria um vazio sobre os títulos
       curtos. */
    align-items: center;
    padding: 56px var(--tp-gutter) 44px;
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
  }

  .tp-hub-consultorios__col {
    grid-column: 1 / 7;
    min-width: 0;
  }

  /* Sem a foto, o texto respira em oito colunas em vez de seis — e o bloco
     encolhe, para o conteúdo começar acima da dobra. */
  .tp-hub-consultorios__intro--sem-imagem {
    padding-block: 44px 28px;
  }

  .tp-hub-consultorios__intro--sem-imagem .tp-hub-consultorios__col {
    grid-column: 1 / 9;
  }

  .tp-hub-consultorios__breadcrumb {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-muted);
    margin-bottom: 14px;
  }

  .tp-hub-consultorios__breadcrumb a:hover {
    color: var(--tp-wine);
  }

  .tp-hub-consultorios__title {
    font-family: var(--tp-serif);
    font-weight: 400;
    font-size: 46px;
    line-height: 1.14;
    margin: 0 0 16px;
  }

  .tp-hub-consultorios__lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--tp-body);
  }

  .tp-hub-consultorios__lead p {
    margin: 0;
  }

  .tp-hub-consultorios__lead p + p {
    margin-top: 10px;
  }

  .tp-hub-consultorios__hero-media {
    grid-column: 8 / 13;
    aspect-ratio: 3 / 2;
  }

  .tp-hub-consultorios__notice-wrap {
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--tp-gutter);
    margin-block: 0 48px;
  }

  .tp-hub-consultorios__notice {
    border: 1px solid rgba(61, 39, 34, 0.24);
    padding: 22px 26px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .tp-hub-consultorios__notice-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tp-wine);
    flex: none;
    padding-top: 2px;
  }

  .tp-hub-consultorios__notice-text {
    font-size: 14px;
    line-height: 1.65;
    color: var(--tp-body);
    max-width: 900px;
  }

  .tp-hub-consultorios__notice-text p {
    margin: 0;
  }

  .tp-hub-consultorios__notice-text p + p {
    margin-top: 8px;
  }

  .tp-hub-consultorios__catalog {
    background: var(--tp-stone);
    padding-block: 36px 44px;
  }

  .tp-hub-consultorios__kits-head,
  .tp-hub-consultorios__kits-grid,
  .tp-hub-consultorios__cartelas-head,
  .tp-hub-consultorios__cartelas-grid,
  .tp-hub-consultorios__soon-grid {
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--tp-gutter);
    box-sizing: border-box;
  }

  .tp-hub-consultorios__kits-head,
  .tp-hub-consultorios__cartelas-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }

  .tp-hub-consultorios__kits-head {
    margin-bottom: 26px;
  }

  .tp-hub-consultorios__cartelas-head {
    margin-bottom: 22px;
  }

  .tp-hub-consultorios__section-title {
    font-family: var(--tp-serif);
    font-size: 30px;
    font-weight: 500;
  }

  .tp-hub-consultorios__section-note {
    font-size: 13px;
    color: var(--tp-muted);
    flex: none;
  }

  .tp-hub-consultorios__kits-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .tp-hub-consultorios__kit {
    background: var(--tp-cream);
    border: 1px solid var(--tp-line);
    padding: 30px 28px;
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .tp-hub-consultorios__kit-media {
    width: 160px;
    height: 160px;
    flex: none;
  }

  .tp-hub-consultorios__kit-body {
    min-width: 0;
  }

  .tp-hub-consultorios__kit-title {
    font-family: var(--tp-serif);
    font-size: 24px;
    font-weight: 500;
    margin-bottom: 6px;
  }

  .tp-hub-consultorios__kit-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--tp-body);
    margin: 0 0 12px;
  }

  .tp-hub-consultorios__kit-price {
    font-size: 20px;
    font-weight: 500;
    margin-bottom: 10px;
  }

  .tp-hub-consultorios__kit-link {
    display: inline-flex;
    font-size: 14px;
    font-weight: 500;
    color: var(--tp-wine);
  }

  .tp-hub-consultorios__cartelas-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .tp-hub-consultorios__cartela-media {
    height: 260px;
    border-radius: 18px;
  }

  .tp-hub-consultorios__cartela-body {
    padding-top: 12px;
  }

  .tp-hub-consultorios__cartela-title {
    font-size: 15px;
  }

  .tp-hub-consultorios__cartela-price {
    font-size: 16px;
    font-weight: 500;
    margin-top: 8px;
  }

  .tp-hub-consultorios__soon-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .tp-hub-consultorios__soon {
    background: var(--tp-cream);
    border: 1px dashed rgba(61, 39, 34, 0.3);
    padding: 26px 24px;
  }

  .tp-hub-consultorios__soon-eyebrow {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tp-muted);
    margin-bottom: 10px;
  }

  .tp-hub-consultorios__soon-title {
    font-family: var(--tp-serif);
    font-size: 22px;
    font-weight: 500;
    margin-bottom: 8px;
  }

  .tp-hub-consultorios__soon-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--tp-body);
    margin: 0 0 14px;
  }

  .tp-hub-consultorios__soon-link {
    display: inline-flex;
    font-size: 14px;
    font-weight: 500;
    color: var(--tp-wine);
  }

  @media (max-width: 1100px) {
    .tp-hub-consultorios__cartelas-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tp-hub-consultorios__soon-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 899px) {
    .tp-hub-consultorios__intro {
      grid-template-columns: minmax(0, 1fr);
      align-items: stretch;
      gap: 24px;
      padding-block: 28px 32px;
    }

    .tp-hub-consultorios__col {
      grid-column: 1;
      grid-row: 2;
    }

    .tp-hub-consultorios__hero-media {
      grid-column: 1;
      grid-row: 1;
    }

    .tp-hub-consultorios__title {
      font-size: 30px;
    }

    .tp-hub-consultorios__notice-wrap {
      margin-block: 0 32px;
    }

    .tp-hub-consultorios__notice {
      flex-direction: column;
      gap: 8px;
      padding: 18px 20px;
    }

    .tp-hub-consultorios__catalog {
      padding-block: 24px 32px;
    }

    .tp-hub-consultorios__kits-head,
    .tp-hub-consultorios__cartelas-head {
      margin-bottom: 18px;
    }

    .tp-hub-consultorios__kits-grid {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 32px;
    }

    .tp-hub-consultorios__kit {
      flex-direction: column;
      align-items: stretch;
      padding: 22px 20px;
      gap: 16px;
    }

    .tp-hub-consultorios__kit-media {
      width: 100%;
      height: 200px;
    }

    .tp-hub-consultorios__cartelas-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 32px;
    }

    .tp-hub-consultorios__cartela-media {
      height: 200px;
      border-radius: 12px;
    }

    .tp-hub-consultorios__soon-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Hub consultórios",
  "settings": [
    {
      "type": "text",
      "id": "breadcrumb_label",
      "label": "Breadcrumb (padrão: nome da coleção)",
      "default": "Consultórios"
    },
    {
