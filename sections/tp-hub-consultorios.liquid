      "id": "description",
      "label": "Descrição",
      "default": "<p>Cartelas, papelaria e materiais de apoio para a rotina do consultório — desenhados para reduzir dúvida, não para substituir orientação.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagem de destaque (padrão: imagem da coleção)"
