      "default": "Que tamanho é esse, de verdade?"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Texto de apoio",
      "default": "<p>Toda peça do catálogo aparece aqui comparada a uma folha A4 — a régua que quase todo mundo tem em casa.</p>"
    },
    {
      "type": "header",
      "content": "Tabela de formatos"
    },
    {
      "type": "text",
      "id": "col_format",
      "label": "Coluna 1",
      "default": "Formato"
    },
    {
      "type": "text",
      "id": "col_measure",
      "label": "Coluna 2",
      "default": "Medida"
    },
    {
      "type": "text",
      "id": "col_compare",
      "label": "Coluna 3",
      "default": "Comparado à A4"
    },
    {
      "type": "header",
      "content": "Escala visual"
    },
    {
      "type": "text",
      "id": "scale_label",
      "label": "Rótulo do card",
      "default": "Escala visual"
    },
    {
      "type": "richtext",
      "id": "scale_note",
      "label": "Legenda do diagrama",
      "default": "<p>Proporções reais entre os formatos mais usados do catálogo.</p>"
    },
    {
      "type": "header",
      "content": "Adesivos por cartela"
    },
    {
      "type": "text",
      "id": "sticker_label",
      "label": "Rótulo do card",
      "default": "Adesivo redondo por cartela A4"
    },
    {
      "type": "text",
      "id": "sticker_link_label",
      "label": "Texto do link",
      "default": "Ver adesivos bottom →"
    },
    {
      "type": "url",
      "id": "sticker_link_url",
      "label": "Link do card"
    }
  ],
  "blocks": [
    {
      "type": "size_row",
      "name": "Linha de formato",
      "settings": [
        {
          "type": "text",
          "id": "format",
          "label": "Formato",
          "default": "A4"
        },
        {
          "type": "text",
          "id": "measure",
          "label": "Medida",
          "default": "21 × 29,7 cm"
        },
        {
          "type": "text",
          "id": "compare",
          "label": "Comparado à A4",
          "default": "A folha inteira"
        }
      ]
    },
    {
      "type": "scale_bar",
      "name": "Barra da escala",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Rótulo (opcional)",
          "default": "A4"
        },
        {
          "type": "number",
