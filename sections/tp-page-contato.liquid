      "default": "Fale com a Thainá"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "Texto de apoio",
      "default": "<p>O caminho mais rápido é o WhatsApp. Se preferir escrever com calma, use o formulário — respondo em até 2 dias úteis.</p>"
    },
    {
      "type": "header",
      "content": "WhatsApp"
