{%- liquid
  assign socials = section.blocks | where: 'type', 'social'
  assign link_cards = section.blocks | where: 'type', 'link_card'
  assign subjects = section.blocks | where: 'type', 'subject'
  assign form_id = 'ContatoForm-' | append: section.id
-%}
{%- liquid
  # Sem destino próprio, o botão cai no WhatsApp global do tema.
  assign _whats = settings.tp_whatsapp_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '+'
  assign _whats_url = ''
  if _whats != blank
    assign _whats_url = 'https://wa.me/' | append: _whats
  endif
-%}

<div class="tp-contato">
  <div class="tp-contato__inner">
    <div class="tp-contato__aside">
      <h1 class="tp-contato__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.lead != blank -%}
        <div class="tp-contato__lead">{{ section.settings.lead }}</div>
      {%- endif -%}

      <div class="tp-contato__info">
        <div class="tp-contato__info-label">{{ section.settings.whatsapp_label }}</div>
        {%- if section.settings.whatsapp_number != blank -%}
          <div class="tp-contato__info-phone">{{ section.settings.whatsapp_number }}</div>
        {%- endif -%}
        {%- if section.settings.whatsapp_button_label != blank -%}
          <a
            {% assign _dest = section.settings.whatsapp_link | default: _whats_url %}{% if _dest != blank %}href="{{ _dest }}"{% endif %}
            class="tp-btn tp-btn--solid tp-contato__wa-btn"
          >
            {{- section.settings.whatsapp_button_label -}}
          </a>
        {%- endif -%}
      </div>

      <div class="tp-contato__info">
        <div class="tp-contato__info-label">{{ section.settings.email_label }}</div>
        <div class="tp-contato__info-value">{{ section.settings.email_value }}</div>
      </div>

      <div class="tp-contato__info">
        <div class="tp-contato__info-label">{{ section.settings.hours_label }}</div>
        <div class="tp-contato__info-value tp-contato__info-value--rte">{{ section.settings.hours_value }}</div>
      </div>

      {%- if socials.size > 0 -%}
        <div class="tp-contato__info tp-contato__info--last">
          <div class="tp-contato__info-label">{{ section.settings.social_label }}</div>
          <div class="tp-contato__socials">
            {%- for block in socials -%}
              <a {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
                {{- block.settings.label -}}
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="tp-contato__main">
      <div class="tp-contato__form-card">
        <div class="tp-contato__form-title">{{ section.settings.form_heading }}</div>

        {%- form 'contact', id: form_id, class: 'tp-contato__form' -%}
          <input type="hidden" name="contact[id]" value="{{ form_id }}">

          {%- liquid
            assign form_matches = false
            if form.id == form_id or form.id == blank
              assign form_matches = true
            endif
          -%}

          {%- if form.errors and form_matches -%}
            <div class="tp-contato__alert tp-contato__alert--error" tabindex="-1" autofocus>
              {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? and form_matches -%}
            <div class="tp-contato__alert tp-contato__alert--success" tabindex="-1" autofocus>
              {{- section.settings.success_message -}}
            </div>
          {%- endif -%}

          <div class="tp-contato__row">
            <div class="tp-contato__field">
              <label class="tp-contato__label" for="{{ form_id }}-name">{{ section.settings.name_label }}</label>
              <input
                type="text"
                id="{{ form_id }}-name"
                class="tp-contato__input"
                name="contact[name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              >
            </div>
            <div class="tp-contato__field">
              <label class="tp-contato__label" for="{{ form_id }}-email">{{ section.settings.email_field_label }}</label>
              <input
                type="email"
                id="{{ form_id }}-email"
                class="tp-contato__input"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                required
                aria-required="true"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              >
            </div>
          </div>

          {%- if subjects.size > 0 -%}
            <div class="tp-contato__field tp-contato__field--chips">
              <span class="tp-contato__label">{{ section.settings.subject_label }}</span>
              <div class="tp-contato__chips">
                {%- for block in subjects -%}
                  <input
                    type="radio"
                    class="tp-contato__chip-input"
                    id="{{ form_id }}-subject-{{ forloop.index }}"
                    name="contact[Assunto]"
                    value="{{ block.settings.label }}"
                    {% if forloop.first %}checked{% endif %}
                    {{ block.shopify_attributes }}
                  >
                  <label class="tp-contato__chip" for="{{ form_id }}-subject-{{ forloop.index }}">
                    {{- block.settings.label -}}
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <div class="tp-contato__field">
            <label class="tp-contato__label" for="{{ form_id }}-body">{{ section.settings.message_label }}</label>
            <textarea
              id="{{ form_id }}-body"
              class="tp-contato__input tp-contato__textarea"
              name="contact[body]"
              rows="6"
            >{{ form.body }}</textarea>
          </div>

          <div class="tp-contato__form-foot">
            <div class="tp-contato__privacy">{{ section.settings.privacy_note }}</div>
            <button type="submit" class="tp-btn tp-btn--solid tp-contato__submit">
              {{- section.settings.submit_label -}}
            </button>
          </div>
        {%- endform -%}
      </div>

      {%- if link_cards.size > 0 -%}
        <div class="tp-contato__cards">
          {%- for block in link_cards -%}
            <a {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} class="tp-contato__card" {{ block.shopify_attributes }}>
              <div class="tp-contato__card-title">{{ block.settings.title }}</div>
              <div class="tp-contato__card-text">{{ block.settings.description }}</div>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if section.settings.announcement_override != blank -%}
  <script>
    (function () {
      var text = {{ section.settings.announcement_override | json }};
      var desktop = document.querySelector('.tp-header__announce--desktop');
      var mobile = document.querySelector('.tp-header__announce--mobile');
      if (desktop) desktop.textContent = text;
      if (mobile) mobile.textContent = text;
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .tp-contato {
    font-family: var(--tp-sans);
    color: var(--tp-ink);
    background: var(--tp-cream);
  }

  .tp-contato * {
    box-sizing: border-box;
  }

  .tp-contato a {
    color: inherit;
    text-decoration: none;
  }

  .tp-contato .tp-btn--solid {
    background: var(--tp-wine);
    color: var(--tp-cream);
  }

  .tp-contato__inner {
    display: flex;
    gap: 56px;
    align-items: flex-start;
    max-width: calc(var(--tp-content-width) + var(--tp-gutter) * 2);
    margin-inline: auto;
    padding-block: 72px;
    padding-inline: var(--tp-gutter);
  }

  .tp-contato__aside {
    width: 520px;
    flex: none;
  }

  .tp-contato__title {
    font-family: var(--tp-serif);
    font-weight: 400;
    font-size: 46px;
    line-height: 1.14;
    margin: 0 0 16px;
  }

  .tp-contato__lead {
    font-size: 16px;
    line-height: 1.7;
    color: var(--tp-body);
    margin-bottom: 34px;
  }

  .tp-contato__lead p {
    margin: 0;
  }

  .tp-contato__lead p + p {
    margin-top: 10px;
  }

  .tp-contato__info {
    border-top: 1px solid var(--tp-line);
    padding-block: 20px;
  }

  .tp-contato__info--last {
    border-bottom: 1px solid var(--tp-line);
  }

  .tp-contato__info-label {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tp-wine);
    margin-bottom: 8px;
  }

  .tp-contato__info-phone {
    font-size: 20px;
    margin-bottom: 12px;
  }

  .tp-contato__info-value {
    font-size: 16px;
  }

  .tp-contato__info-value--rte {
    line-height: 1.7;
  }

  .tp-contato__info-value--rte p {
    margin: 0;
  }

  .tp-contato__wa-btn {
    height: 46px;
    padding-inline: 22px;
    font-size: 14px;
  }

  .tp-contato__socials {
    display: flex;
    gap: 20px;
    font-size: 15px;
  }

  .tp-contato__socials a:hover {
    color: var(--tp-wine);
  }

  .tp-contato__main {
    flex: 1;
    min-width: 0;
  }

  /* Azul destaca a ação principal da página. */
  .tp-contato__form-card {
    background: var(--tp-blue);
    padding: 36px 34px 32px;
  }

  .tp-contato__form-title {
    font-family: var(--tp-serif);
    font-size: 26px;
    font-weight: 500;
    margin-bottom: 22px;
  }

  .tp-contato__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 18px;
  }

  .tp-contato__field {
    margin-bottom: 18px;
  }

  .tp-contato__row .tp-contato__field {
    margin-bottom: 0;
  }

  .tp-contato__field--chips {
    margin-bottom: 18px;
  }

  .tp-contato__label {
    display: block;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tp-muted);
    margin-bottom: 8px;
  }

  .tp-contato .tp-contato__input {
    display: block;
    width: 100%;
    height: 46px;
    padding-inline: 14px;
    background: var(--tp-cream);
    border: 1px solid rgba(61, 39, 34, 0.24);
    border-radius: 0;
    font-family: var(--tp-sans);
    font-size: 14px;
    color: var(--tp-ink);
  }

  .tp-contato__input:focus-visible {
    outline: 2px solid var(--tp-wine);
    outline-offset: -1px;
  }

  .tp-contato__textarea {
    height: 150px;
    padding-block: 12px;
    resize: vertical;
    line-height: 1.6;
  }

  .tp-contato__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tp-contato__chip-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .tp-contato__chip {
    display: flex;
    align-items: center;
    height: 36px;
    padding-inline: 14px;
    border: 1px solid rgba(61, 39, 34, 0.28);
    font-size: 13px;
    cursor: pointer;
  }

  .tp-contato__chip-input:checked + .tp-contato__chip {
    border-color: var(--tp-ink);
    background: var(--tp-ink);
    color: var(--tp-cream);
  }

  .tp-contato__chip-input:focus-visible + .tp-contato__chip {
    outline: 2px solid var(--tp-wine);
    outline-offset: 2px;
  }

  .tp-contato__form-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 22px;
  }

  .tp-contato__privacy {
    font-size: 13px;
    line-height: 1.6;
    color: var(--tp-muted);
    max-width: 380px;
  }

  .tp-contato__submit {
    flex: none;
    height: 52px;
    padding-inline: 30px;
    font-size: 15px;
    border: none;
    font-family: var(--tp-sans);
  }

  .tp-contato__alert {
    padding: 14px 16px;
    margin-bottom: 18px;
    font-size: 14px;
    line-height: 1.5;
  }

  .tp-contato__alert--error {
    background: rgba(107, 16, 23, 0.1);
    color: var(--tp-wine);
  }

  .tp-contato__alert--success {
    background: var(--tp-cream);
    color: var(--tp-ink);
    border: 1px solid var(--tp-line);
  }

  .tp-contato__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  .tp-contato__card {
    display: block;
    border: 1px solid var(--tp-line);
    padding: 22px 20px;
    transition: border-color 0.2s ease;
  }

  .tp-contato__card:hover {
    border-color: var(--tp-line-strong);
  }

  .tp-contato__card-title {
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 6px;
  }

  .tp-contato__card-text {
    font-size: 13px;
    line-height: 1.6;
    color: var(--tp-muted);
  }

  @media (max-width: 1100px) {
    .tp-contato__inner {
      gap: 32px;
    }

    .tp-contato__aside {
      width: 400px;
    }
  }

  @media (max-width: 899px) {
    .tp-contato__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
      padding-block: 32px 40px;
    }

    .tp-contato__aside {
      width: auto;
    }

    .tp-contato__title {
      font-size: 30px;
    }

    .tp-contato__lead {
      margin-bottom: 24px;
    }

    .tp-contato__form-card {
      padding: 24px 20px 22px;
    }

    .tp-contato__row {
      grid-template-columns: 1fr;
    }

    .tp-contato__row .tp-contato__field + .tp-contato__field {
      margin-top: 18px;
    }

    .tp-contato__form-foot {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .tp-contato__privacy {
      max-width: none;
    }

    .tp-contato__submit {
      width: 100%;
      justify-content: center;
    }

    .tp-contato__cards {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Contato",
  "settings": [
    {
      "type": "text",
      "id": "announcement_override",
      "label": "Aviso do topo (só nesta página)",
      "default": "Atendimento de segunda a sexta, das 9h às 18h"
    },
    {
      "type": "text",
      "id": "heading",
