{%- comment -%}
  Como pedir: três passos numa linha do tempo costurada. Um fio vinho
  tracejado liga os numerais (vertical no celular, horizontal no desktop)
  e se desenha quando a lista entra na tela. Cada passo tem chips com os
  detalhes concretos — o que mandar, quantos ajustes, prazo — para a pessoa
  não precisar perguntar o básico no WhatsApp.
{%- endcomment -%}
{%- capture wa_msg -%}Olá, Thainá! Quero fazer um pedido.{%- endcapture -%}
<section class="lp-passos lp-papel">
  <div class="lp-cabeca">
    <p class="lp-script" data-lp-reveal="up">{{ section.settings.script }}</p>
    <h2 class="lp-display lp-cabeca__titulo" data-lp-reveal="wipe">{{ section.settings.titulo }}</h2>
  </div>

  <ol class="lp-passos__lista" data-lp-reveal="fio">
    {%- for b in section.blocks -%}
      <li class="lp-passo" style="--i: {{ forloop.index0 }}" {{ b.shopify_attributes }}>
        <span class="lp-passo__num" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
        <div class="lp-passo__corpo">
          <h3 class="lp-passo__titulo">{{ b.settings.titulo }}</h3>
          <p class="lp-passo__texto">{{ b.settings.texto }}</p>
          {%- assign chips = b.settings.chips | split: ',' -%}
          {%- if chips.size > 0 -%}
            <ul class="lp-passo__chips">
              {%- for c in chips -%}
                {%- assign c = c | strip -%}
                {%- if c != blank -%}<li>{{ c }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ol>

  <div class="lp-passos__fim" data-lp-reveal="up">
    <a class="lp-btn lp-btn--vinho" href="{% render 'tp-lp-wa', message: wa_msg %}" target="_blank" rel="noopener">
      {%- render 'tp-lp-icone-wa' -%} {{ section.settings.botao }}
    </a>
    {%- if section.settings.nota != blank -%}
      <p class="lp-passos__nota">{{ section.settings.nota }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LP — Como pedir",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "script", "label": "Manuscrito", "default": "sem complicação" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Como pedir" },
    { "type": "text", "id": "botao", "label": "Botão", "default": "Começar pelo WhatsApp" },
    { "type": "text", "id": "nota", "label": "Nota abaixo do botão", "default": "Atendimento direto com a Thainá, de segunda a sexta." }
  ],
  "blocks": [
    {
      "type": "passo",
      "name": "Passo",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Escolha" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Escolha o modelo no catálogo." },
        { "type": "text", "id": "chips", "label": "Detalhes (separados por vírgula)" }
      ]
    }
  ],
  "presets": [{ "name": "LP — Como pedir", "blocks": [{ "type": "passo" }, { "type": "passo" }, { "type": "passo" }] }]
}
{% endschema %}
