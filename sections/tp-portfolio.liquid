{%- liquid
  assign blocks = section.blocks
-%}

<section class="tp-section tp-portfolio">
  <div class="tp-section-head">
    {%- if section.settings.heading != blank -%}
      <h2 class="tp-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      {%- assign destino = section.settings.link | default: routes.root_url -%}
      {%- comment -%}
        Link externo abre em aba nova: quem está vendo os trabalhos não
        deve perder a navegação da loja ao conferir o perfil.
      {%- endcomment -%}
      <a
        href="{{ destino }}"
        class="tp-link-caps"
        {% if destino contains '://' %}
          target="_blank"
          rel="noopener"
        {% endif %}
      >
        {{- section.settings.link_label -}}
      </a>
    {%- endif -%}
  </div>

  <div class="tp-portfolio__grid">
    {%- for block in blocks -%}
      {%- assign position = forloop.index -%}
      <div class="tp-portfolio__cell tp-portfolio__cell--{{ position }}" {{ block.shopify_attributes }}>
        {%- render 'tp-image',
          image: block.settings.image,
          asset: block.settings.image_asset,
          alt: block.settings.caption,
          class: 'tp-portfolio__media',
          ratio: '2/3',
          width: 1200,
          sizes: '(max-width: 899px) 84vw, 24vw',
          widths: '300,500,700,1000,1200'
        -%}
        {%- if block.settings.caption != blank -%}
          <div class="tp-portfolio__caption">{{ block.settings.caption }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .tp-portfolio {
    padding-block: 0 84px;
  }

  /* Carrossel em qualquer tela, sangrando de borda a borda.

     A faixa é filha direta de .tp-section, e quem limita a largura é a regra
     `body .tp-section > *` do design system. Basta soltar o teto aqui para
     ela ocupar a tela inteira — sem 100vw e sem margem negativa, que somam a
     barra de rolagem e fazem a PÁGINA andar de lado. O `padding-inline` fica,
     e vira a folga das duas pontas da faixa.

     Escopado com duas classes para vencer `body .tp-section > *` (0,1,1)
     independentemente de qual folha de estilo carregue primeiro. */
  .tp-portfolio .tp-portfolio__grid {
    display: grid;
    grid-auto-flow: column;
    /* Cresce com a tela até um teto, para não virar cartaz em monitor grande. */
    grid-auto-columns: clamp(260px, 22vw, 400px);
    gap: 16px;
    align-items: start;
    max-width: none;
    margin-inline: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--tp-gutter);
    scrollbar-width: none;
  }

  .tp-portfolio__grid::-webkit-scrollbar {
    display: none;
  }

  .tp-portfolio__cell {
    scroll-snap-align: start;
    min-width: 0;
  }

  /* 2:3 em vez de 3:4: as fotos da Thainá são todas de celular em pé, e o
     quadro mais alto devolve o que o corte anterior tirava — o bolo inteiro,
     o convite com os nomes do casal. */
  .tp-portfolio__media {
    aspect-ratio: 2 / 3;
  }

  .tp-portfolio__caption {
    font-size: 12px;
    line-height: 1.45;
    color: var(--tp-muted);
    margin-top: 10px;
  }

  @media (max-width: 899px) {
    .tp-portfolio {
      padding-block: 0 34px;
    }

    /* No celular o card ocupa quase a tela e o seguinte espia na borda —
       é o que mostra, sem seta nenhuma, que a faixa anda. */
    .tp-portfolio .tp-portfolio__grid {
      grid-auto-columns: 82%;
      gap: 12px;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "TP — Trabalhos reais",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Trabalhos reais"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link",
      "default": "Ver portfólio"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "work",
      "name": "Imagem",
      "settings": [
        {
          "type": "text",
          "id": "image_asset",
          "label": "Arquivo no tema (fallback)",
          "info": "Usado só quando nenhuma imagem é escolhida."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Legenda do espaço vazio"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP — Trabalhos reais",
      "blocks": [
        { "type": "work" },
        { "type": "work" },
        { "type": "work" },
        { "type": "work" },
        { "type": "work" }
      ]
    }
  ]
}
{% endschema %}
