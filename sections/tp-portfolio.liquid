{%- liquid
  assign blocks = section.blocks
-%}

<section class="tp-section tp-portfolio">
  <div class="tp-section-head">
    {%- if section.settings.heading != blank -%}
      <h2 class="tp-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      {%- assign destino = section.settings.link | default: routes.root_url -%}
      {%- comment -%}
        Link externo abre em aba nova: quem está vendo os trabalhos não
        deve perder a navegação da loja ao conferir o perfil.
      {%- endcomment -%}
      <a
        href="{{ destino }}"
        class="tp-link-caps"
        {% if destino contains '://' %}
          target="_blank"
          rel="noopener"
        {% endif %}
      >
        {{- section.settings.link_label -}}
      </a>
    {%- endif -%}
  </div>

  <div class="tp-portfolio__grid">
    {%- for block in blocks -%}
      {%- assign position = forloop.index -%}
      <div class="tp-portfolio__cell tp-portfolio__cell--{{ position }}" {{ block.shopify_attributes }}>
        {%- render 'tp-image',
          image: block.settings.image,
          asset: block.settings.image_asset,
          alt: block.settings.caption,
          class: 'tp-portfolio__media',
          width: 1000,
          sizes: '(max-width: 899px) 70vw, 20vw',
          widths: '300,500,1000'
        -%}
        {%- if block.settings.caption != blank -%}
          <div class="tp-portfolio__caption">{{ block.settings.caption }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .tp-portfolio {
    padding-block: 0 84px;
  }

  /* Fileira de retratos, não mosaico deitado. O material da Thainá é foto de
     celular em pé — bolo inteiro, mesa posta, convite na mão. No mosaico
     antigo, de células deitadas, toda foto virava uma tira cortada no meio. */
  .tp-portfolio__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    align-items: start;
  }

  .tp-portfolio__media {
    aspect-ratio: 3 / 4;
  }

  /* Altura alternada: quebra a régua reta e deixa a fileira respirar sem
     precisar de foto maior nem de corte diferente. */
  .tp-portfolio__cell--2,
  .tp-portfolio__cell--4 {
    margin-top: 34px;
  }

  .tp-portfolio__caption {
    font-size: 12px;
    line-height: 1.45;
    color: var(--tp-muted);
    margin-top: 10px;
  }

  @media (max-width: 899px) {
    .tp-portfolio {
      padding-block: 0 34px;
    }

    /* No celular vira carrossel horizontal. Cinco retratos empilhados em duas
       colunas viravam uma parede de rolagem; deitados numa faixa, o dedo
       percorre os trabalhos como quem passa fotos.

       Quem rola é a própria grade, não a página — a faixa sangra até a borda
       da tela e reaproveita o gutter que .tp-section > * já aplica como folga
       das pontas, então não precisa de margem negativa. */
    .tp-portfolio__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 68%;
      gap: 12px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--tp-gutter);
      scrollbar-width: none;
    }

    .tp-portfolio__grid::-webkit-scrollbar {
      display: none;
    }

    .tp-portfolio__cell {
      scroll-snap-align: start;
      min-width: 0;
    }

    /* O degrau é do desktop: numa faixa deitada ele só desalinharia as fotos. */
    .tp-portfolio__cell--2,
    .tp-portfolio__cell--4 {
      margin-top: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TP — Trabalhos reais",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Trabalhos reais"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link",
      "default": "Ver portfólio"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "work",
      "name": "Imagem",
      "settings": [
        {
          "type": "text",
          "id": "image_asset",
          "label": "Arquivo no tema (fallback)",
          "info": "Usado só quando nenhuma imagem é escolhida."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Legenda do espaço vazio"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP — Trabalhos reais",
      "blocks": [
        { "type": "work" },
        { "type": "work" },
        { "type": "work" },
        { "type": "work" },
        { "type": "work" }
      ]
    }
  ]
}
{% endschema %}
